---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  return sortedPosts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      newerPost: index > 0 ? sortedPosts[index - 1] : null,
      olderPost: index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null,
    },
  }));
}

const { post, newerPost, olderPost } = Astro.props;
const { Content } = await post.render();

const formatDatePrecise = (date: Date) => {
  const day = date.toLocaleDateString('en-US', { day: 'numeric' });
  const month = date.toLocaleDateString('en-US', { month: 'short' });
  const year = date.getFullYear();
  return `${month} ${day}, ${year}`;
};

const words = post.body.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(words / 220));
---

<BaseLayout title={post.data.title} description={post.data.description} showProgress={true}>
  <article class="post single max-w-3xl mx-auto py-2 font-serif">

    <!-- TOP BACK LINK -->
    <div class="font-mono text-xs uppercase tracking-wider mb-6">
      <a href="/blog" class="text-stone-500 dark:text-stone-400 hover:text-brand-light dark:hover:text-brand-dark hover:underline inline-flex items-center gap-1">
        &larr; All Essays
      </a>
    </div>

    <!-- HEADER -->
    <header class="post-header space-y-3 mb-8 pb-6 border-b border-stone-300/80 dark:border-stone-800">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 dark:text-stone-100 leading-tight !m-0">
        {post.data.title}
      </h1>
      <div class="flex flex-wrap items-center gap-2 text-stone-500 dark:text-stone-400 font-mono text-xs">
        <time datetime={post.data.date.toISOString()}>{formatDatePrecise(post.data.date)}</time>
        <span>&middot;</span>
        <span>{readingTime} min read</span>
      </div>
    </header>

    <!-- ARTICLE BODY -->
    <div class="body text-stone-800 dark:text-stone-200 text-base sm:text-[17px] leading-relaxed">
      <Content />
    </div>

    <!-- TAGS -->
    {post.data.tags && post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-10 pt-6 border-t border-stone-200 dark:border-stone-800">
        {post.data.tags.map((tag) => (
          <span class="mono-pill">
            {tag.toLowerCase()}
          </span>
        ))}
      </div>
    )}

    <!-- NEXT / PREVIOUS ESSAY NAVIGATION -->
    {(newerPost || olderPost) && (
      <nav class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8 pt-6 border-t border-stone-300/80 dark:border-stone-800 font-serif">
        <div>
          {olderPost && (
            <a href={`/blog/${olderPost.slug}`} class="group block space-y-1">
              <span class="font-mono text-[10px] uppercase tracking-wider text-stone-500 dark:text-stone-400 block">
                &larr; Previous Essay
              </span>
              <span class="font-bold text-sm sm:text-base text-stone-900 dark:text-stone-100 group-hover:text-brand-light dark:group-hover:text-brand-dark group-hover:underline">
                {olderPost.data.title}
              </span>
            </a>
          )}
        </div>
        <div class="sm:text-right">
          {newerPost && (
            <a href={`/blog/${newerPost.slug}`} class="group block space-y-1">
              <span class="font-mono text-[10px] uppercase tracking-wider text-stone-500 dark:text-stone-400 block">
                Next Essay &rarr;
              </span>
              <span class="font-bold text-sm sm:text-base text-stone-900 dark:text-stone-100 group-hover:text-brand-light dark:group-hover:text-brand-dark group-hover:underline">
                {newerPost.data.title}
              </span>
            </a>
          )}
        </div>
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .body :global(a) {
    color: #2c4a3e;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
  }
  :global(.dark) .body :global(a) {
    color: #629e7a;
  }
  .body :global(a:hover) {
    color: #b34d2b;
  }
  :global(.dark) .body :global(a:hover) {
    color: #e07a5f;
  }

  .body :global(img) {
    border-radius: 6px;
    max-width: 100%;
    height: auto;
    margin: 28px auto;
    display: block;
    border: 1px solid rgba(168, 162, 158, 0.35);
  }

  .body :global(figure) {
    margin: 28px 0;
    text-align: center;
  }

  .body :global(figcaption) {
    font-family: 'DM Mono', monospace;
    font-size: 0.75rem;
    color: #78716c;
    margin-top: 8px;
  }

  .body :global(p) {
    margin-bottom: 22px;
    line-height: 1.78em;
  }

  .body :global(h2),
  .body :global(h3),
  .body :global(h4) {
    font-family: 'Lora', Georgia, serif;
    font-weight: 700;
    line-height: 1.3em;
    margin: 36px 0 14px 0;
    color: #1c1917;
  }
  :global(.dark) .body :global(h2),
  :global(.dark) .body :global(h3),
  :global(.dark) .body :global(h4) {
    color: #f5f5f4;
  }

  .body :global(h2) {
    font-size: 1.45rem;
    border-bottom: 1px solid rgba(168, 162, 158, 0.35);
    padding-bottom: 6px;
  }

  .body :global(h3) {
    font-size: 1.2rem;
  }

  .body :global(blockquote) {
    background: rgba(255, 255, 255, 0.55);
    font-style: italic;
    border-left: 3px solid #2c4a3e;
    padding: 12px 20px;
    margin: 26px 0;
    border-radius: 0 4px 4px 0;
  }
  :global(.dark) .body :global(blockquote) {
    background: rgba(28, 25, 23, 0.55);
    border-left-color: #629e7a;
  }

  .body :global(ul),
  .body :global(ol) {
    padding-left: 24px;
    margin-bottom: 22px;
  }

  .body :global(ul) {
    list-style-type: disc;
  }

  .body :global(ol) {
    list-style-type: decimal;
  }

  .body :global(li) {
    margin-bottom: 8px;
    line-height: 1.75em;
  }

  .body :global(code) {
    font-family: 'DM Mono', monospace;
    font-size: 0.85em;
    background: rgba(168, 162, 158, 0.2);
    padding: 2px 5px;
    border-radius: 3px;
  }

  .body :global(pre) {
    padding: 16px;
    border-radius: 6px;
    overflow-x: auto;
    margin: 24px 0;
    border: 1px solid rgba(168, 162, 158, 0.35);
  }
  .body :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .body :global(table) {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    width: 100%;
    border-collapse: collapse;
    margin: 28px 0;
    font-size: 0.9rem;
    line-height: 1.6;
    font-variant-numeric: tabular-nums;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(168, 162, 158, 0.45);
    border-radius: 6px;
  }
  :global(.dark) .body :global(table) {
    background: rgba(28, 25, 23, 0.7);
    border-color: rgba(68, 64, 60, 0.8);
  }
  @media (min-width: 640px) {
    .body :global(table) {
      display: table;
      font-size: 0.92rem;
    }
  }
  .body :global(th),
  .body :global(td) {
    text-align: left;
    padding: 14px 18px;
    vertical-align: top;
    border-bottom: 1px solid rgba(168, 162, 158, 0.28);
    border-right: 1px solid rgba(168, 162, 158, 0.22);
  }
  :global(.dark) .body :global(th),
  :global(.dark) .body :global(td) {
    border-bottom-color: rgba(68, 64, 60, 0.55);
    border-right-color: rgba(68, 64, 60, 0.4);
  }
  .body :global(th:last-child),
  .body :global(td:last-child) {
    border-right: none;
  }
  .body :global(tbody tr:last-child td),
  .body :global(tbody tr:last-child th) {
    border-bottom: none;
  }
  .body :global(tbody tr:nth-child(even)) {
    background: rgba(21, 128, 61, 0.04);
  }
  :global(.dark) .body :global(tbody tr:nth-child(even)) {
    background: rgba(52, 211, 153, 0.05);
  }
  .body :global(thead th) {
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(247, 245, 240, 0.9);
    border-bottom: 1.5px solid #1c1917;
    color: #1c1917;
  }
  :global(.dark) .body :global(thead th) {
    background: rgba(28, 25, 23, 0.95);
    border-bottom-color: #d6d3d1;
    color: #f5f5f4;
  }

  /* Inline Editorial Bar Charts inside Blog Posts */
  .body :global(.blog-chart) {
    margin: 28px 0;
    padding: 18px 22px;
    border-radius: 6px;
    border: 1px solid rgba(168, 162, 158, 0.45);
    background: rgba(255, 255, 255, 0.65);
    text-align: left;
  }
  :global(.dark) .body :global(.blog-chart) {
    background: rgba(28, 25, 23, 0.65);
    border-color: rgba(68, 64, 60, 0.8);
  }
  .body :global(.blog-chart-title) {
    font-family: 'Lora', Georgia, serif;
    font-weight: 700;
    font-size: 1rem;
    color: #1c1917;
    margin: 0 0 2px 0;
  }
  :global(.dark) .body :global(.blog-chart-title) {
    color: #f5f5f4;
  }
  .body :global(.blog-chart-sub) {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    color: #78716c;
    margin: 0 0 14px 0 !important;
    line-height: 1.4 !important;
  }
  .body :global(.blog-bars) {
    position: relative;
    padding: 2px 115px 4px 0;
  }
  .body :global(.blog-bar-row) {
    margin-bottom: 10px;
  }
  .body :global(.blog-bar-row:last-child) {
    margin-bottom: 0;
  }
  .body :global(.blog-bar-label) {
    display: block;
    font-size: 0.82rem;
    line-height: 1.35;
    margin-bottom: 4px;
  }
  .body :global(.blog-bar-track) {
    position: relative;
    height: 12px;
    background: rgba(168, 162, 158, 0.2);
    border-radius: 2px;
  }
  :global(.dark) .body :global(.blog-bar-track) {
    background: rgba(68, 64, 60, 0.4);
  }
  .body :global(.blog-bar-fill) {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: #78716c;
  }
  .body :global(.blog-bar-fill.green) {
    background: #15803d;
  }
  :global(.dark) .body :global(.blog-bar-fill.green) {
    background: #34d399;
  }
  .body :global(.blog-bar-fill.amber) {
    background: #b45309;
  }
  :global(.dark) .body :global(.blog-bar-fill.amber) {
    background: #fbbf24;
  }
  .body :global(.blog-bar-fill.red) {
    background: #991b1b;
  }
  :global(.dark) .body :global(.blog-bar-fill.red) {
    background: #f87171;
  }
  .body :global(.blog-bar-val) {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-family: 'DM Mono', monospace;
    font-size: 0.74rem;
    font-weight: 600;
    white-space: nowrap;
    color: #1c1917;
  }
  :global(.dark) .body :global(.blog-bar-val) {
    color: #f5f5f4;
  }
  .body :global(.blog-chart-note) {
    margin: 12px 0 0 0 !important;
    padding-top: 10px;
    border-top: 1px solid rgba(168, 162, 158, 0.28);
    font-size: 0.82rem !important;
    line-height: 1.5 !important;
    color: #57534e;
  }
  :global(.dark) .body :global(.blog-chart-note) {
    border-top-color: rgba(68, 64, 60, 0.55);
    color: #a8a29e;
  }
</style>
