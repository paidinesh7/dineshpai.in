---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDay = (date: Date) => {
  // Returns: "Mon, 02" (e.g. "Wed, 11")
  const weekday = date.toLocaleDateString('en-US', { weekday: 'short' });
  const day = date.toLocaleDateString('en-US', { day: '2-digit' });
  return `${weekday}, ${day}`;
};

const formatYear = (date: Date) => {
  // Returns: "Jan 2006" (e.g. "Oct 2023")
  const month = date.toLocaleDateString('en-US', { month: 'short' });
  const year = date.getFullYear();
  return `${month} ${year}`;
};
---

<BaseLayout title="Blog Archive">
  <section class="page">
    <h3 class="title" style="font-size: 2rem; font-family: Ramaraja, Georgia, serif; font-weight: 600; margin-bottom: 20px;">
      Blog
    </h3>

    <div class="posts">
      {sortedPosts.map((post) => (
        <div class="post">
          <div class="date">
            <span class="day">{formatDay(post.data.date)}</span>
            <span class="year">{formatYear(post.data.date)}</span>
          </div>
          <div class="body">
            <h3 class="title">
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h3>
            {post.data.description && (
              <div class="description">
                {post.data.description}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
