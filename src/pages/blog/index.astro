---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDay = (date: Date) => {
  // Returns: "Mon, 02" (e.g. "Wed, 11")
  const weekday = date.toLocaleDateString('en-US', { weekday: 'short' });
  const day = date.toLocaleDateString('en-US', { day: '2-digit' });
  return `${weekday}, ${day}`;
};

const formatYear = (date: Date) => {
  // Returns: "Jan 2006" (e.g. "Oct 2023")
  const month = date.toLocaleDateString('en-US', { month: 'short' });
  const year = date.getFullYear();
  return `${month} ${year}`;
};
---

<BaseLayout title="Blog Archive">
  <section class="page">
    <h3 class="title font-mono font-bold" style="font-size: 2rem; margin-bottom: 24px;">
      [ dinesh_pai:archive ]
    </h3>

    <div class="posts">
      {sortedPosts.map((post) => (
        <div class="post">
          <div class="date">
            <span class="day">{formatDay(post.data.date)}</span>
            <span class="year">{formatYear(post.data.date)}</span>
          </div>
          <div class="body">
            <h3 class="title">
              <a href={`/blog/${post.slug}`} class="text-brand-light dark:text-brand-dark hover:underline">{post.data.title}</a>
            </h3>
            {post.data.description && (
              <div class="description">
                {post.data.description}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* Custom Typewriter Overrides for Pixel-Perfect spacing and brand colors */
  .posts .post {
    border-bottom: 1px dashed rgba(44, 74, 62, 0.18) !important;
    padding: 24px 0 !important;
  }
  .posts .post .body .title a {
    color: #2c4a3e !important;
    font-weight: 700 !important;
    font-family: 'Courier Prime', 'Courier New', Courier, monospace !important;
    font-size: 1.15rem !important;
    text-decoration: none !important;
  }
  :global(.dark) .posts .post .body .title a {
    color: #629e7a !important;
  }
  .posts .post .body .title a:hover {
    text-decoration: underline !important;
  }
  .posts .post .body .description {
    font-family: 'Courier Prime', 'Courier New', Courier, monospace !important;
    font-size: 0.85rem !important;
    color: #555 !important;
    margin-top: 8px !important;
    line-height: 1.5em !important;
  }
  :global(.dark) .posts .post .body .description {
    color: #aaa !important;
  }
  .posts .post .date {
    font-family: 'Courier Prime', 'Courier New', Courier, monospace !important;
    font-size: 0.8rem !important;
    color: #777 !important;
  }
  :global(.dark) .posts .post .date {
    color: #888 !important;
  }
</style>
