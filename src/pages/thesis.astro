        </div>

        <!-- Visual Comparison of Population Share by Income Slab -->
        <div class="mt-6 pt-5 border-t border-stone-200/90 dark:border-stone-800">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <span class="font-mono text-[11px] uppercase tracking-wider text-stone-600 dark:text-stone-400 font-medium">
