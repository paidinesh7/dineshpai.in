                </div>
                <div class="bar-line">
                  <div class="bar-seg bg-brand-light dark:bg-brand-dark" style="width: 88%"></div>
                  <span class="bar-val font-semibold text-stone-900 dark:text-stone-100">47% (715M)</span>
                </div>
