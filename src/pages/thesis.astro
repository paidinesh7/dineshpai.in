                </tr>
                <tr>
                  <th scope="row">Fermentation KSM</th>
                  <td>~15-20%</td>
                  <td>80-90%</td>
                  <td>Antibiotic Plant</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Panel 2: Equipment Lead Time vs Downstream Capital Delayed -->
        <div class="data-card">
          <div class="el-label">Project Hold-Up Math</div>
          <div class="stat-hero text-brand-light dark:text-brand-dark mt-1">20 to 30 mo</div>
          <p class="el-sub">wait time for high-voltage grid hardware and custom tooling</p>
          <div class="overflow-x-auto">
            <table class="el-table">
              <thead>
                <tr>
                  <th scope="col">Bottleneck Hardware</th>
                  <th scope="col">Unit Cost</th>
