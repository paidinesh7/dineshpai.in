<script>
  const NTFY_TOPIC = 'dpai_thesis_notes_7f3a9c2e8b1d4f6a';

  const initThesisNoteForm = () => {
    const form = document.getElementById('thesis-note-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('note-status');
    const submitBtn = document.getElementById('note-submit-btn') as HTMLButtonElement | null;

    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!statusEl || !submitBtn) return;

      const formData = new FormData(form);
      const name = String(formData.get('name') || '').trim() || 'Anonymous';
      const contact = String(formData.get('contact') || '').trim();
      const message = String(formData.get('message') || '').trim();

      if (!message) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      statusEl.textContent = '';

      const payload = {
        name,
        contact,
        message,
        page: window.location.pathname,
        submitted_at: new Date().toISOString(),
      };

      try {
        const res = await fetch(`https://ntfy.sh/${NTFY_TOPIC}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Title': `Thesis note from ${name}`,
          },
          body: JSON.stringify(payload),
        });

        if (!res.ok) throw new Error('Network error');

        form.reset();
        statusEl.textContent = 'Saved — queued for the 6:00 PM email digest.';
        statusEl.className = 'font-mono text-xs text-brand-light dark:text-brand-dark';
      } catch {
        statusEl.textContent = 'Could not send right now. Please email dinesh@zerodha.com directly.';
        statusEl.className = 'font-mono text-xs text-red-600 dark:text-red-400';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send note';
      }
    });
  };

  initThesisNoteForm();
  document.addEventListener('astro:page-load', initThesisNoteForm);
</script>

