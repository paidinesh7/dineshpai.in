---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { weeklySignals } from '../data/weeklySignals';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Sort signals chronologically
const sortedSignals = weeklySignals.sort((a, b) => b.id.localeCompare(a.id));

const dineshPodcasts = [
  {
    title: "Nithin Kamath's Guide to How Startups Think of Risks & Moats",
    series: "The Startup Blueprint — Special Episode",
    speakers: "Nithin Kamath (Co-founder, Zerodha) & Dinesh Pai",
    description: "Nithin breaks down how Zerodha scaled through referral pricing, technology, and brand credibility, along with his core frameworks on risk management and capital allocation.",
    link: "https://www.youtube.com/watch?v=eZdrpChV0C4&t=38s",
    tags: ["Risk Management", "Business Moats", "Capital Allocation"]
  },
  {
    title: "How VCs Measure Product-Market Fit",
    series: "How VCs Think — Episode 7",
    speakers: "Sajith Pai (Blume Ventures) & Dinesh Pai (Rainmatter)",
    description: "Breaking down PMF into Product-to-Problem Fit and Motion-to-Market Fit, the GRUE framework, and why common metrics can mislead early-stage founders.",
    link: "https://www.youtube.com/watch?v=-TqOl7NjB7o",
    tags: ["Product-Market Fit", "Metrics", "Frameworks"]
  },
  {
    title: "What VCs Look For in the First Meeting",
    series: "How VCs Think — Episode 1",
    speakers: "Kushal Bhagia (All In Capital) & Dinesh Pai (Rainmatter)",
    description: "Demystifying the initial founder-investor meeting: the 'Why You?' test, the value of earned operational insights, and early-stage cap table red flags.",
    link: "https://www.youtube.com/watch?v=dhuHgsGevks&t=96s",
    tags: ["First Meeting", "Pitching", "Equity Splits"]
  },
  {
    title: "How to Hire and Retain Early Employees",
    series: "How VCs Think — Episode 4",
    speakers: "Dinesh Pai (Rainmatter) & Portfolio Founders",
    description: "Navigating early-stage talent acquisition, aligning long-term incentives, and building a mission that outlasts monetary compensation.",
    link: "https://www.youtube.com/watch?v=0fxTjJ9jVpg&t=14s",
    tags: ["Hiring", "Company Culture", "Early Stage"]
  },
  {
    title: "How to Find a Co-founder",
    series: "The Startup Blueprint — Episode 1",
    speakers: "Ashish Goel (Co-founder, Urban Ladder) & Dinesh Pai",
    description: "A tactical guide to co-founder alignment: identifying complementary 'spiky' skill sets, value matching, and why a 3-month trial period is vital.",
    link: "https://www.youtube.com/watch?v=ORPVZgc2ScM",
    tags: ["Co-founders", "Partnerships", "Team Building"]
  },
  {
    title: "Decoding Bain's India Venture Capital Report",
    series: "Subtext by Zerodha",
    speakers: "Aditya Shukla & Aditya Muralidhar (Partners, Bain & Company India) & Dinesh Pai",
    description: "A comprehensive breakdown of Bain's annual Indian VC report, changing LP sentiment toward India, and emerging domestic capital tailwinds.",
    link: "https://www.youtube.com/watch?v=TbsWx16UFhM&t=4950s",
    tags: ["Capital Markets", "LP Sentiment", "Venture Report"]
  }
];
---

<BaseLayout title="VP of Investments at Zerodha / Rainmatter" description="Dinesh Pai helps Zerodha manage private market investments at Rainmatter, and climate action projects through the Rainmatter Foundation.">
  <div class="max-w-3xl mx-auto space-y-16 py-6 font-serif">
    
    <!-- BIO SECTION -->
    <section class="block">
      <!-- Content text size set to text-sm sm:text-base for elegant readability -->
      <div class="text-stone-800 dark:text-stone-200 leading-relaxed text-sm sm:text-base space-y-4">
        <!-- Desktop/Tablet Floated Profile Photo -->
        <div class="w-32 h-32 sm:w-40 sm:h-40 float-right ml-6 mb-4 sm:ml-8 sm:mb-6 shrink-0 relative bg-stone-100 dark:bg-stone-900 border border-stone-200 dark:border-stone-800 rounded-lg overflow-hidden shadow-sm hidden sm:block">
          <img 
            src="/static/images/dinesh_new.jpg" 
            alt="Dinesh Pai" 
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Mobile centered Profile Photo -->
        <div class="w-32 h-32 mx-auto mb-6 relative bg-stone-100 dark:bg-stone-900 border border-stone-200 dark:border-stone-800 rounded-lg overflow-hidden shadow-sm sm:hidden">
          <img 
            src="/static/images/dinesh_new.jpg" 
            alt="Dinesh Pai" 
            class="w-full h-full object-cover"
          />
        </div>

        <p>
          I grew up on the banks of River Seetha in <span class="font-bold text-stone-950 dark:text-stone-50">Udupi</span>. After graduating in engineering (2014), I worked at D.E. Shaw India, completed my MBA in Calgary, Canada, and spent my twenties getting my hands dirty with real-world operations.
        </p>
        <p>
          My steepest learning curve wasn’t business school—it was two early, failed attempts at entrepreneurship (delivering engineering textbooks in Bangalore and student housing in Canada). Managing logistics, suppliers, and cash flows laid bare the stark difference between a clean spreadsheet and messy operational reality. It gave me the scar tissue to understand and empathize with founders today.
        </p>
        <p>
          In 2020, I joined <a href="https://zerodha.com/" class="text-brand-light dark:text-brand-dark font-bold hover:underline">Zerodha</a> to help people do better with their money. Today, I lead private market investments at <a href="https://rainmatter.com/" class="text-brand-light dark:text-brand-dark font-bold hover:underline">Rainmatter</a> and work on grassroots livelihood and climate projects via the <a href="https://rainmatter.org/" class="text-brand-light dark:text-brand-dark font-bold hover:underline">Rainmatter Foundation</a>.
        </p>
      </div>
    </section>

    <!-- HOW I INVEST SECTION -->
    <section class="space-y-4">
      <h2 class="font-mono text-xl sm:text-2xl font-bold uppercase tracking-wider text-stone-900 dark:text-stone-100 border-b border-stone-200 dark:border-stone-800 pb-1.5">
        How I Invest
      </h2>
      <div class="text-stone-800 dark:text-stone-200 leading-relaxed text-sm sm:text-base space-y-4">
        <p>
          At <a href="https://rainmatter.com/" class="text-brand-light dark:text-brand-dark font-bold hover:underline">Rainmatter</a>, we operate differently from traditional venture capital. We invest Zerodha's own balance sheet without outside LPs, giving us a 20- to 30-year horizon with zero pressure to force artificial exits. When evaluating teams, I look for four simple traits:
        </p>
        <ul class="space-y-3 pl-5 list-disc mt-2">
          <li>
            <strong class="text-stone-950 dark:text-stone-50">Structural Edge:</strong> Business models that incumbents cannot easily copy without hurting their own existing revenue.
          </li>
          <li>
            <strong class="text-stone-950 dark:text-stone-50">Ecosystem First:</strong> Teams focused on creating far more value for their customers and ecosystem than they extract.
          </li>
          <li>
            <strong class="text-stone-950 dark:text-stone-50">Cash-Flow Reality:</strong> Unit economics that make immediate, practical sense on the ground—not just on a spreadsheet.
          </li>
          <li>
            <strong class="text-stone-950 dark:text-stone-50">Hard Problems & Patient Moats:</strong> Deep-engineering, climate, and healthcare businesses where high entry barriers reward patient capital.
          </li>
        </ul>
        <p class="pt-2">
          Across everything we back, we look for <strong>simplicity, extreme cost-discipline, and founders who do right by their customers and teams.</strong> If you are building with these values, <a href="https://www.linkedin.com/in/paidinesh1/" target="_blank" rel="noopener noreferrer" class="text-brand-light dark:text-brand-dark font-bold hover:underline">let's talk</a>.
        </p>
        <div class="pt-1 font-mono text-xs uppercase tracking-wider">
          <a href="/portfolio" class="text-stone-500 dark:text-stone-400 hover:text-brand-light dark:hover:text-brand-dark hover:underline inline-flex items-center gap-1 group">
            View the startups and teams we've backed <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- THE WEEKLY SIGNAL SECTION -->
    <section class="space-y-4">
      <div class="border-b border-stone-200 dark:border-stone-800 pb-1.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
        <!-- Title size increased from text-lg to text-xl sm:text-2xl -->
        <h2 class="font-mono text-xl sm:text-2xl font-bold uppercase tracking-wider text-stone-900 dark:text-stone-100">
          The Weekly Signal
        </h2>
        <span class="text-xs text-stone-400 dark:text-stone-500 font-mono">
          3 links &bull; Why they matter
        </span>
      </div>
      <p class="font-serif italic text-stone-500 dark:text-stone-400 text-xs sm:text-sm leading-relaxed">
        Every week, I share exactly 3 highly-curated links (articles, frameworks, or podcasts) with a 2-sentence "why it matters" takeaway for Indian founders and investors.
      </p>

      {sortedSignals.length > 0 && (
        <div class="space-y-6 mt-4">
          <!-- LATEST SIGNAL -->
          <div class="space-y-2">
            <h3 class="font-mono text-sm font-bold text-stone-900 dark:text-stone-100 bg-stone-100 dark:bg-stone-900 px-2.5 py-1 rounded inline-block">
              {sortedSignals[0].week}
            </h3>
            <ul class="space-y-4 pl-4 border-l-2 border-stone-200 dark:border-stone-800 mt-2">
              {sortedSignals[0].items.map((item) => (
                <li class="space-y-1.5">
                  <div class="flex flex-wrap items-center gap-x-2 text-[10px] font-mono font-bold text-stone-400 dark:text-stone-500 uppercase tracking-wide">
                    <span class="stamp-badge stamp-rust">{item.category}</span>
                    <span>&bull;</span>
                    <span>{item.source}</span>
                  </div>
                  <div>
                    <a href={item.url} target="_blank" rel="noopener noreferrer" class="font-serif font-bold text-stone-900 dark:text-stone-100 hover:text-brand-light dark:hover:text-brand-dark hover:underline inline-flex items-center gap-1 group">
                      {item.title}
                      <span class="text-stone-400 dark:text-stone-500 text-xs group-hover:translate-x-0.5 transition-transform">&rarr;</span>
                    </a>
                  </div>
                  <p class="font-serif text-xs sm:text-sm text-stone-600 dark:text-stone-400 italic pl-3 border-l border-stone-200 dark:border-stone-800">
                    <strong class="text-[10px] font-mono font-bold uppercase tracking-wider block text-stone-400 dark:text-stone-500 mb-0.5">Why this matters:</strong>
                    {item.takeaway}
                  </p>
                </li>
              ))}
            </ul>
          </div>

          <!-- PAST SIGNALS TOGGLE -->
          {sortedSignals.length > 1 && (
            <div class="pt-4">
              <button 
                id="toggle-past-signals" 
                class="font-mono text-xs font-bold text-stone-500 dark:text-stone-400 hover:text-brand-light dark:hover:text-brand-dark hover:underline inline-flex items-center gap-1 cursor-pointer bg-none border-none p-0"
              >
                <span>&darr; Show Past Weekly Signals</span>
              </button>
              
              <div id="past-signals-container" class="hidden space-y-6 mt-6 pt-4 border-t border-dashed border-stone-200 dark:border-stone-800">
                {sortedSignals.slice(1).map((signal) => (
                  <div class="space-y-2">
                    <h3 class="font-mono text-sm font-bold text-stone-500 dark:text-stone-400 bg-stone-50 dark:bg-stone-950 px-2.5 py-1 rounded inline-block">
                      {signal.week}
                    </h3>
                    <ul class="space-y-4 pl-4 border-l-2 border-stone-100 dark:border-stone-900 mt-2">
                      {sortedSignals.slice(1) && signal.items.map((item) => (
                        <li class="space-y-1.5">
                          <div class="flex flex-wrap items-center gap-x-2 text-[10px] font-mono font-bold text-stone-400 dark:text-stone-500 uppercase tracking-wide">
                            <span class="stamp-badge stamp-neutral">{item.category}</span>
                            <span>&bull;</span>
                            <span>{item.source}</span>
                          </div>
                          <div>
                            <a href={item.url} target="_blank" rel="noopener noreferrer" class="font-serif font-bold text-stone-900 dark:text-stone-100 hover:text-brand-light dark:hover:text-brand-dark hover:underline inline-flex items-center gap-1 group">
                              {item.title}
                              <span class="text-stone-400 dark:text-stone-500 text-xs group-hover:translate-x-0.5 transition-transform">&rarr;</span>
                            </a>
                          </div>
                          <p class="font-serif text-xs sm:text-sm text-stone-600 dark:text-stone-400 italic pl-3 border-l border-stone-200 dark:border-stone-800">
                            <strong class="text-[10px] font-mono font-bold uppercase tracking-wider block text-stone-400 dark:text-stone-500 mb-0.5">Why this matters:</strong>
                            {item.takeaway}
                          </p>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      )}
    </section>

    <!-- ESSAYS / WRITING SECTION -->
    <section class="space-y-4">
      <!-- Title size increased from text-lg to text-xl sm:text-2xl -->
      <h2 class="font-mono text-xl sm:text-2xl font-bold uppercase tracking-wider text-stone-900 dark:text-stone-100 border-b border-stone-200 dark:border-stone-800 pb-1.5">
        Essays & Writing
      </h2>
      <ul class="space-y-3">
        {sortedPosts.slice(0, 5).map((post) => (
          <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
            <span class="text-stone-400 dark:text-stone-500 font-mono text-xs sm:text-sm shrink-0 w-28">
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
            </span>
            <div class="flex-grow">
              <a href={`/blog/${post.slug}`} class="font-serif font-bold text-stone-900 dark:text-stone-100 hover:text-accent-light dark:hover:text-accent-dark hover:underline">
                {post.data.title}
              </a>
              {post.data.description && (
                <p class="text-stone-500 dark:text-stone-400 text-xs sm:text-sm mt-0.5 max-w-2xl font-serif leading-relaxed">
                  {post.data.description}
                </p>
              )}
            </div>
          </li>
        ))}
      </ul>
      <div class="pt-2 font-mono text-xs uppercase tracking-wider">
        <a href="/blog" class="text-stone-500 dark:text-stone-400 hover:text-brand-light dark:hover:text-brand-dark hover:underline inline-flex items-center gap-1 group">
          View all {sortedPosts.length} essays <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
        </a>
      </div>
    </section>

    <!-- PODCASTS SECTION -->
    <section class="space-y-4">
      <!-- Title size increased from text-lg to text-xl sm:text-2xl -->
      <h2 class="font-mono text-xl sm:text-2xl font-bold uppercase tracking-wider text-stone-900 dark:text-stone-100 border-b border-stone-200 dark:border-stone-800 pb-1.5">
        Podcasts & Video Discussions
      </h2>
      <ul class="space-y-6">
        {dineshPodcasts.map((podcast) => (
          <li class="space-y-1">
            <div class="text-[10px] font-mono font-bold text-stone-400 dark:text-stone-500 uppercase tracking-wider">
              {podcast.series} &bull; {podcast.speakers}
            </div>
            <h3 class="text-base font-bold text-stone-900 dark:text-stone-100">
              <a href={podcast.link} target="_blank" rel="noopener noreferrer" class="font-serif font-bold hover:text-accent-light dark:hover:text-accent-dark hover:underline inline-flex items-center gap-1 group">
                {podcast.title}
                <span class="text-stone-400 dark:text-stone-500 text-xs group-hover:translate-x-0.5 transition-transform">&rarr;</span>
              </a>
            </h3>
            <p class="text-stone-600 dark:text-stone-400 text-xs sm:text-sm leading-relaxed font-serif">
              {podcast.description}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <!-- PROJECTS SECTION -->
    <section class="space-y-4">
      <!-- Title size increased from text-lg to text-xl sm:text-2xl -->
      <h2 class="font-mono text-xl sm:text-2xl font-bold uppercase tracking-wider text-stone-900 dark:text-stone-100 border-b border-stone-200 dark:border-stone-800 pb-1.5">
        Featured Toolkits & Projects
      </h2>
      <ul class="space-y-4">
        <li class="space-y-1">
          <h3 class="text-base font-bold text-stone-900 dark:text-stone-100">
            <a href="https://github.com/paidinesh7/onepager" target="_blank" rel="noopener noreferrer" class="font-serif font-bold hover:text-accent-light dark:hover:text-accent-dark hover:underline inline-flex items-center gap-1 group">
              onepager
              <span class="text-stone-400 dark:text-stone-500 text-xs group-hover:translate-x-0.5 transition-transform">&rarr;</span>
            </a>
          </h3>
          <p class="text-stone-600 dark:text-stone-400 text-xs sm:text-sm leading-relaxed font-serif">
            An AI-powered financial analyzer that generates quick briefs (Altman Z-Score, Piotroski F-Score, DuPont Analysis) from statements in under 2 minutes.
          </p>
        </li>
        <li class="space-y-1">
          <h3 class="text-base font-bold text-stone-900 dark:text-stone-100">
            <a href="https://github.com/paidinesh7/LegalOS" target="_blank" rel="noopener noreferrer" class="font-serif font-bold hover:text-accent-light dark:hover:text-accent-dark hover:underline inline-flex items-center gap-1 group">
              LegalOS
              <span class="text-stone-400 dark:text-stone-500 text-xs group-hover:translate-x-0.5 transition-transform">&rarr;</span>
            </a>
          </h3>
          <p class="text-stone-600 dark:text-stone-400 text-xs sm:text-sm leading-relaxed font-serif">
            An AI legal document analyzer designed specifically for Indian startup founders navigating fundraising agreements like SHAs and SPAs.
          </p>
        </li>
      </ul>
    </section>

  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggleBtn = document.getElementById('toggle-past-signals');
    const container = document.getElementById('past-signals-container');
    
    if (toggleBtn && container) {
      toggleBtn.addEventListener('click', () => {
        const isHidden = container.classList.contains('hidden');
        if (isHidden) {
          container.classList.remove('hidden');
          toggleBtn.innerHTML = '<span>&uarr; Hide Past Weekly Signals</span>';
        } else {
          container.classList.add('hidden');
          toggleBtn.innerHTML = '<span>&darr; Show Past Weekly Signals</span>';
        }
      });
    }
  });
</script>
