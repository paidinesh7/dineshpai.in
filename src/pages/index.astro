---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { weeklySignals } from '../data/weeklySignals';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Sort signals chronologically
const sortedSignals = weeklySignals.sort((a, b) => b.id.localeCompare(a.id));

const dineshPodcasts = [
  {
    title: "Nithin Kamath's Guide to How Startups Think of Risks & Moats",
    series: "The Startup Blueprint",
    speakers: "With Nithin Kamath (Zerodha)",
    description: "Scaling without external capital or marketing spend, managing tail risk, and long-term capital allocation.",
    link: "https://www.youtube.com/watch?v=eZdrpChV0C4&t=38s",
  },
  {
    title: "How VCs Measure Product-Market Fit",
    series: "How VCs Think — Ep. 7",
    speakers: "With Sajith Pai (Blume Ventures)",
    description: "Separating true product-to-problem fit from subsidized top-line growth at Seed and Series A.",
    link: "https://www.youtube.com/watch?v=-TqOl7NjB7o",
  },
  {
    title: "What VCs Look For in the First Meeting",
    series: "How VCs Think — Ep. 1",
    speakers: "With Kushal Bhagia (All In Capital)",
    description: "Evaluating founder-market fit, earned insights from the field, and early cap-table mistakes.",
    link: "https://www.youtube.com/watch?v=dhuHgsGevks&t=96s",
  },
  {
    title: "How to Hire and Retain Early Employees",
    series: "How VCs Think — Ep. 4",
    speakers: "With Rainmatter Portfolio Founders",
    description: "Hiring the first ten engineers and operators, structuring ESOPs, and keeping teams together.",
    link: "https://www.youtube.com/watch?v=0fxTjJ9jVpg&t=14s",
  },
  {
    title: "How to Find a Co-founder",
    series: "The Startup Blueprint — Ep. 1",
    speakers: "With Ashish Goel (Urban Ladder)",
    description: "Testing for complementary skills, stress-testing values, and structuring equity splits.",
    link: "https://www.youtube.com/watch?v=ORPVZgc2ScM",
  },
  {
    title: "Decoding Bain's India Venture Capital Report",
    series: "Subtext by Zerodha",
    speakers: "With Bain & Company India",
    description: "Private capital flows into India, domestic family offices, and public-market exit liquidity.",
    link: "https://www.youtube.com/watch?v=TbsWx16UFhM&t=4950s",
  }
];
---

<BaseLayout
  title="Home"
  description="Dinesh Pai leads private market investments at Zerodha's Rainmatter fund and long-term ecological capital allocation at the Rainmatter Foundation."
>
  <div class="space-y-10 sm:space-y-14 py-1 sm:py-2 font-serif">

    <!-- BIO & PORTRAIT MASTHEAD -->
    <section class="grid grid-cols-1 md:grid-cols-[1fr_200px] gap-5 md:gap-8 items-start">
      <div class="text-stone-800 dark:text-stone-200 leading-relaxed text-[15px] sm:text-base space-y-4 max-w-3xl">
        <div class="float-right ml-4 mb-2 w-24 h-24 sm:w-32 sm:h-32 md:hidden editorial-card p-1 overflow-hidden shrink-0">
          <img
            src="/static/images/dinesh_new.jpg"
            alt="Dinesh Pai"
            class="w-full h-full object-cover rounded-[3px]"
          />
        </div>
        <p>
          I grew up by the River Seetha in <strong class="text-stone-950 dark:text-stone-50">Udupi</strong>. After studying computer science at RVCE (2014), I started my career in financial research at D.E. Shaw India and later completed my MBA at the University of Calgary.
        </p>
        <p>
          Along the way, I built and shut down two small businesses—a textbook delivery service in Bangalore and a student housing venture in Canada. Dealing firsthand with working capital cycles, vendor terms, and thin operating margins taught me more about business mortality than any financial model.
        </p>
        <p>
          Since 2020, I have been at <a href="https://zerodha.com/" target="_blank" rel="noopener noreferrer" class="text-brand-light dark:text-brand-dark font-bold hover:underline">Zerodha</a>, where I lead private market investments at <a href="https://rainmatter.com/" target="_blank" rel="noopener noreferrer" class="text-brand-light dark:text-brand-dark font-bold hover:underline">Rainmatter</a> and work on long-term ecological and rural livelihood initiatives through the <a href="https://rainmatter.org/" target="_blank" rel="noopener noreferrer" class="text-brand-light dark:text-brand-dark font-bold hover:underline">Rainmatter Foundation</a>.
        </p>
        <div class="pt-1 clear-both flex flex-wrap items-center gap-x-2.5 sm:gap-x-4 gap-y-1.5 font-mono text-[11px] sm:text-xs text-stone-500 dark:text-stone-400">
          <a href="mailto:dinesh@zerodha.com" class="hover:text-brand-light dark:hover:text-brand-dark hover:underline">
            dinesh@zerodha.com
          </a>
          <span aria-hidden="true">&middot;</span>
          <a href="https://x.com/dineshpaii" target="_blank" rel="noopener noreferrer" class="hover:text-brand-light dark:hover:text-brand-dark hover:underline">
            X (@dineshpaii)
          </a>
          <span aria-hidden="true">&middot;</span>
          <a href="https://www.linkedin.com/in/paidinesh1/" target="_blank" rel="noopener noreferrer" class="hover:text-brand-light dark:hover:text-brand-dark hover:underline">
            LinkedIn
          </a>
        </div>
      </div>

      <div class="hidden md:block md:w-[190px] md:h-[190px] md:justify-self-end editorial-card p-1.5 overflow-hidden shrink-0">
        <img
          src="/static/images/dinesh_new.jpg"
          alt="Dinesh Pai"
          class="w-full h-full object-cover rounded-[4px]"
        />
      </div>
    </section>

    <!-- INTERACTIVE HOOK: GOVERNOR FOR A TERM -->
    <section>
      <div class="editorial-card p-4 sm:p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 sm:gap-5">
        <div class="space-y-2 max-w-2xl">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[11px] uppercase tracking-wider text-brand-light dark:text-brand-dark font-semibold">
            <span>Governor for a Term</span>
            <span class="text-stone-400">&middot;</span>
            <span class="text-stone-500 dark:text-stone-400 font-normal">The Central Bank Game</span>
          </div>
          <h2 class="font-serif text-base sm:text-xl font-bold text-stone-900 dark:text-stone-100 leading-snug">
            Can you run the RBI for a term without breaking the Rupee or inflation?
          </h2>
          <p class="text-stone-600 dark:text-stone-400 text-xs sm:text-sm leading-relaxed">
            Step into the Governor's chair across 8 Indian macro eras—from the 1991 gold airlift and 2013 taper tantrum to a 2027 AI shock. Play the streamlined <strong>1-Decision-Per-Turn Edition</strong> (one clear policy call every 6 months) or the full 5-lever central bank terminal.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row md:flex-col gap-2.5 w-full md:w-auto shrink-0">
          <a
            href="/mint-street/mint_street_simple.html"
            class="w-full sm:w-auto px-4 py-2.5 bg-stone-900 dark:bg-stone-100 text-stone-50 dark:text-stone-900 font-mono text-xs uppercase tracking-wider font-semibold rounded-[4px] hover:opacity-90 transition-opacity text-center no-underline"
          >
            Play Simple Edition (1-Call) &rarr;
          </a>
          <a
            href="/mint-street/index.html"
            class="w-full sm:w-auto px-4 py-2 border border-stone-300 dark:border-stone-700 text-stone-700 dark:text-stone-300 font-mono text-[11px] uppercase tracking-wider rounded-[4px] hover:border-stone-900 dark:hover:border-stone-300 transition-colors text-center no-underline"
          >
            Full 5-Lever Terminal &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- ESSAYS & WRITING -->
    <section class="space-y-4">
      <div class="section-rule">
        <h2 class="section-heading">Essays &amp; Writing</h2>
        <a href="/blog" class="section-meta hover:text-brand-light dark:hover:text-brand-dark hover:underline">
          View all {sortedPosts.length} essays &rarr;
        </a>
      </div>

      <div class="divide-y divide-stone-200/90 dark:divide-stone-800/90">
        {sortedPosts.slice(0, 6).map((post) => (
          <article class="py-3.5 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6">
            <time
              datetime={post.data.date.toISOString()}
              class="font-mono text-xs text-stone-500 dark:text-stone-400 shrink-0 w-24 tabular-nums"
            >
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
            </time>
            <div class="flex-grow">
              <a
                href={`/blog/${post.slug}`}
                class="font-serif font-bold text-stone-900 dark:text-stone-100 hover:text-brand-light dark:hover:text-brand-dark hover:underline text-[15px] sm:text-base"
              >
                {post.data.title}
              </a>
              {post.data.description && (
                <p class="text-stone-600 dark:text-stone-400 text-xs sm:text-sm mt-0.5 leading-relaxed">
                  {post.data.description}
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- THE WEEKLY SIGNAL -->
    <section class="space-y-4">
      <div class="section-rule">
        <h2 class="section-heading">The Weekly Signal</h2>
        <span class="section-meta">{sortedSignals[0]?.week || 'Three links a week'}</span>
      </div>

      {sortedSignals.length > 0 && (
        <div class="space-y-5">
          <div class="divide-y divide-stone-200/90 dark:divide-stone-800/90">
            {sortedSignals[0].items.map((item) => (
              <div class="py-3.5 grid grid-cols-1 sm:grid-cols-[220px_1fr] gap-1 sm:gap-6 items-baseline">
                <div class="font-mono text-xs text-stone-500 dark:text-stone-400">
                  <span class="sm:block text-stone-700 dark:text-stone-300 font-medium">{item.source}</span>
                  <span class="sm:hidden mx-1.5 text-stone-400">&middot;</span>
                  <span class="sm:block text-[11px]">{item.category}</span>
                </div>
                <div>
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-serif font-bold text-stone-900 dark:text-stone-100 hover:text-brand-light dark:hover:text-brand-dark hover:underline text-[15px] sm:text-base"
                  >
                    {item.title} <span class="text-stone-400 text-xs font-normal">&nearr;</span>
                  </a>
                  <p class="text-stone-600 dark:text-stone-400 text-xs sm:text-sm mt-0.5 leading-relaxed">
                    {item.takeaway}
                  </p>
                </div>
              </div>
            ))}
          </div>

          {sortedSignals.length > 1 && (
            <div class="pt-1">
              <button
                id="toggle-past-signals"
                class="font-mono text-xs font-semibold uppercase tracking-wider text-stone-600 dark:text-stone-400 hover:text-brand-light dark:hover:text-brand-dark hover:underline inline-flex items-center gap-1 cursor-pointer bg-transparent border-0 p-0"
              >
                <span>&darr; Show previous weeks ({sortedSignals.length - 1})</span>
              </button>

              <div id="past-signals-container" class="hidden space-y-6 mt-5 pt-4 border-t border-stone-200 dark:border-stone-800">
                {sortedSignals.slice(1).map((signal) => (
                  <div class="space-y-1">
                    <div class="font-mono text-[11px] font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400 pb-1">
                      {signal.week}
                    </div>
                    <div class="divide-y divide-stone-200/80 dark:divide-stone-800/80">
                      {signal.items.map((item) => (
                        <div class="py-3 grid grid-cols-1 sm:grid-cols-[220px_1fr] gap-1 sm:gap-6 items-baseline">
                          <div class="font-mono text-xs text-stone-500 dark:text-stone-400">
                            <span class="sm:block text-stone-700 dark:text-stone-300 font-medium">{item.source}</span>
                            <span class="sm:hidden mx-1.5 text-stone-400">&middot;</span>
                            <span class="sm:block text-[11px]">{item.category}</span>
                          </div>
                          <div>
                            <a
                              href={item.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="font-serif font-bold text-stone-900 dark:text-stone-100 hover:text-brand-light dark:hover:text-brand-dark hover:underline text-sm sm:text-[15px]"
                            >
                              {item.title} <span class="text-stone-400 text-xs font-normal">&nearr;</span>
                            </a>
                            <p class="text-stone-600 dark:text-stone-400 text-xs sm:text-sm mt-0.5 leading-relaxed">
                              {item.takeaway}
                            </p>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      )}
    </section>

    <!-- PODCASTS & DISCUSSIONS -->
    <section class="space-y-4">
      <div class="section-rule">
        <h2 class="section-heading">Podcasts &amp; Discussions</h2>
        <span class="section-meta">Conversations with founders &amp; investors</span>
      </div>

      <div class="divide-y divide-stone-200/90 dark:divide-stone-800/90">
        {dineshPodcasts.map((podcast) => (
          <div class="py-3.5 grid grid-cols-1 sm:grid-cols-[220px_1fr] gap-1 sm:gap-6 items-baseline">
            <div class="font-mono text-xs text-stone-500 dark:text-stone-400">
              <span class="sm:block text-stone-700 dark:text-stone-300 font-medium">{podcast.series}</span>
              <span class="sm:hidden mx-1.5 text-stone-400">&middot;</span>
              <span class="sm:block text-[11px]">{podcast.speakers}</span>
            </div>
            <div>
              <a
                href={podcast.link}
                target="_blank"
                rel="noopener noreferrer"
                class="font-serif font-bold text-stone-900 dark:text-stone-100 hover:text-brand-light dark:hover:text-brand-dark hover:underline text-[15px] sm:text-base"
              >
                {podcast.title} <span class="text-stone-400 text-xs font-normal">&nearr;</span>
              </a>
              <p class="text-stone-600 dark:text-stone-400 text-xs sm:text-sm mt-0.5 leading-relaxed">
                {podcast.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- TOOLS & SIDE PROJECTS -->
    <section class="space-y-4">
      <div class="section-rule">
        <h2 class="section-heading">Tools &amp; Side Projects</h2>
        <span class="section-meta">Public utilities &amp; open source</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a
          href="/before-you-invest/index.html"
          class="editorial-card p-4 sm:p-5 hover:border-stone-900 dark:hover:border-stone-300 transition-colors group no-underline space-y-1.5"
        >
          <div class="flex items-center justify-between">
            <h3 class="font-mono text-sm font-bold text-stone-900 dark:text-stone-100 group-hover:text-brand-light dark:group-hover:text-brand-dark">
              Before You Invest &rarr;
            </h3>
            <span class="mono-pill">6 Languages</span>
          </div>
          <p class="text-stone-600 dark:text-stone-400 text-xs sm:text-sm leading-relaxed">
            13 Indian financial products (stocks, mutual funds, FDs, SGBs, REITs, NPS, ULIPs) stripped down to what you actually own, post-tax returns, and the hidden catch—in English, Kannada, Hindi, Tamil, Telugu, and Marathi.
          </p>
        </a>

        <a
          href="/mint-street/mint_street_simple.html"
          class="editorial-card p-4 sm:p-5 hover:border-stone-900 dark:hover:border-stone-300 transition-colors group no-underline space-y-1.5"
        >
          <div class="flex items-center justify-between">
            <h3 class="font-mono text-sm font-bold text-stone-900 dark:text-stone-100 group-hover:text-brand-light dark:group-hover:text-brand-dark">
              Governor for a Term &rarr;
            </h3>
            <span class="mono-pill">Macro Game</span>
          </div>
          <p class="text-stone-600 dark:text-stone-400 text-xs sm:text-sm leading-relaxed">
            Interactive RBI policy game across 8 historical and future macro eras—make one clear monetary policy call per turn (or switch to the full 5-lever desk) under supply shocks and Black Swans.
          </p>
        </a>

        <a
          href="https://github.com/paidinesh7/onepager"
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-card p-4 sm:p-5 hover:border-stone-900 dark:hover:border-stone-300 transition-colors group no-underline space-y-1.5"
        >
          <div class="flex items-center justify-between">
            <h3 class="font-mono text-sm font-bold text-stone-900 dark:text-stone-100 group-hover:text-brand-light dark:group-hover:text-brand-dark">
              onepager &nearr;
            </h3>
            <span class="mono-pill">Financials</span>
          </div>
          <p class="text-stone-600 dark:text-stone-400 text-xs sm:text-sm leading-relaxed">
            Parses corporate financial statements to compute Altman Z-Scores, Piotroski F-Scores, and DuPont decompositions in under two minutes.
          </p>
        </a>

        <a
          href="https://github.com/paidinesh7/LegalOS"
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-card p-4 sm:p-5 hover:border-stone-900 dark:hover:border-stone-300 transition-colors group no-underline space-y-1.5"
        >
          <div class="flex items-center justify-between">
            <h3 class="font-mono text-sm font-bold text-stone-900 dark:text-stone-100 group-hover:text-brand-light dark:group-hover:text-brand-dark">
              LegalOS &nearr;
            </h3>
            <span class="mono-pill">Term Sheets &amp; SHAs</span>
          </div>
          <p class="text-stone-600 dark:text-stone-400 text-xs sm:text-sm leading-relaxed">
            Helps founders and investment teams review Indian fundraising documents—flagging non-standard clauses across Term Sheets, SHAs, and SPAs.
          </p>
        </a>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggleBtn = document.getElementById('toggle-past-signals');
    const container = document.getElementById('past-signals-container');

    if (toggleBtn && container) {
      toggleBtn.addEventListener('click', () => {
        const isHidden = container.classList.contains('hidden');
        const count = container.children.length;
        if (isHidden) {
          container.classList.remove('hidden');
          toggleBtn.innerHTML = `<span>&uarr; Hide previous weeks (${count})</span>`;
        } else {
          container.classList.add('hidden');
          toggleBtn.innerHTML = `<span>&darr; Show previous weeks (${count})</span>`;
        }
      });
    }
  });
</script>
