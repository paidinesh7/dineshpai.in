---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import UdupiFlipDeck from '../components/UdupiFlipDeck';
import HomeTabs from '../components/HomeTabs';
import { dailySnippets } from '../data/snippets';

const posts = await getCollection('blog');
const latestPosts = posts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<BaseLayout>
  <!-- Home Page Tabbed Interface -->
  <HomeTabs client:load>
    
    <!-- 02 / ABOUT ME TAB -->
    <div slot="aboutContent" class="animate-fade-in">
      <div class="flex flex-col-reverse md:flex-row gap-12 md:gap-16 items-start">
        
        <!-- Bio Text -->
        <div class="flex-1 space-y-6">
          <div class="font-serif text-stone-700 dark:text-stone-300 leading-relaxed text-base sm:text-lg space-y-6">
            <p>
              I grew up on the banks of River Seetha in <span class="font-bold text-stone-950 dark:text-stone-50 border-b border-dashed border-brand-light/35">Udupi</span>. Having watched everyone in the family build small businesses, I had decided early in life that I would always want to find my way towards capital markets. Once I graduated from engineering in 2014, I joined D.E Shaw India, a hedge fund. I was amazed at how much more there was to learn; so went and got my MBA in 2019 from the cleanest city on earth, Calgary, Canada.
            </p>
            <p>
              From 2010 until 2020 was about learning everything in finance and investments. In the process, I was bitten by Venture Capital and how VC investing could potentially build the next notable technology or product. When I left for Canada in August 2017, I knew I would return to India to work for an Indian company. And it all came together in 2020 when I met the fantastic team at Zerodha. I had followed Zerodha for 6 years, and it was serendipitous and lucky that I met the Zerodha team for an opportunity to join them in their mission to help people do better with their money. 
            </p>
            <p>
              I currently work at <a href="https://zerodha.com/" class="text-brand-light dark:text-brand-dark font-bold highlighter-hover transition-all">Zerodha</a>, where I help with investments in private markets through <a href="https://rainmatter.com/" class="text-brand-light dark:text-brand-dark font-bold highlighter-hover transition-all">Rainmatter</a>. I am also passionate about projects that can safeguard livelihoods most at risk via the <a href="https://rainmatter.org/" class="text-brand-light dark:text-brand-dark font-bold highlighter-hover transition-all">Rainmatter Foundation</a>.
            </p>
            <p class="text-stone-600 dark:text-stone-400 italic text-base border-l-2 border-dashed border-stone-200 dark:border-stone-800 pl-4 mt-6">
              A lot of finance is just history repeating itself, and since I read a bunch of blogs and listen to a bunch of podcasts weekly, I felt summarizing some of the content and sharing my thoughts with everyone here would help me learn more and improve.
            </p>
          </div>
        </div>

        <!-- Right Column: Card Stacks -->
        <div class="flex flex-col gap-10 shrink-0 items-center justify-center w-full md:w-auto">
          <!-- Udupi Polaroid Flip Deck -->
          <UdupiFlipDeck client:load />

          <!-- Profile Photo (Bespoke Analog Polaroid Frame) -->
          <div class="w-36 h-36 sm:w-44 sm:h-44 shrink-0 relative bg-stone-50 dark:bg-stone-900 p-2 border-2 border-stone-950/80 dark:border-stone-800/80 rounded-2xl analog-shadow transition-transform hover:scale-102">
            <img 
              src="/static/images/dinesh_new.jpg" 
              alt="Dinesh Pai" 
              class="w-full h-full object-cover rounded-xl"
            />
          </div>
        </div>

      </div>
    </div>

    <!-- 01 / NOTES & IDEAS TAB -->
    <div slot="notesContent" class="space-y-16 sm:space-y-24 animate-fade-in">
      
      <!-- Featured Insights & Projects -->
      <section class="animate-fade-in">
        <div class="space-y-1 mb-8">
          <span class="text-xs font-bold uppercase tracking-widest text-stone-400 dark:text-stone-500 font-mono">
            Curation
          </span>
          <h2 class="font-mono text-xl sm:text-2xl font-bold text-stone-900 dark:text-stone-100 uppercase ink-bleed">
            [ Featured Ideas & Toolkits ]
          </h2>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          
          <!-- Viral X Post Card (Storytelling) -->
          <div class="flex flex-col border border-dashed border-brand-light/30 dark:border-brand-dark/30 bg-stone-50/40 dark:bg-stone-900/15 rounded-2xl p-6 hover:border-brand-light dark:hover:border-brand-dark transition-all duration-300 relative group shadow-sm">
            <div class="flex items-center gap-2 mb-4">
              <!-- Small Twitter/X Logo SVG -->
              <svg class="h-4 w-4 text-stone-400 dark:text-stone-500" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 7.75 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.285L1.254 2.25h6.854l4.665 6.148 5.475-6.148zm-1.16 17.52h1.833L7.084 4.126H5.117L17.084 19.77z"/>
              </svg>
              <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-stone-400 dark:text-stone-500">
                Communication & Strategy
              </span>
              <span class="absolute top-4 right-4 bg-brand-light/10 dark:bg-brand-dark/15 text-brand-light dark:text-brand-dark text-[9px] font-mono font-bold uppercase px-2 py-0.5 rounded">
                Top Thread
              </span>
            </div>

            <div class="space-y-3 flex-grow">
              <h3 class="font-mono text-base sm:text-lg font-bold text-stone-900 dark:text-stone-100 group-hover:text-brand-light dark:group-hover:text-brand-dark transition-colors duration-200">
                <a href="https://x.com/dineshpaii/status/2075086708635521283" target="_blank" rel="noopener noreferrer" class="highlighter-hover">
                  The Importance of Storytelling
                </a>
              </h3>
              <p class="font-serif text-stone-600 dark:text-stone-400 text-sm leading-relaxed">
                "A startup can have the most advanced technology or product, but without a compelling narrative, it is nearly impossible to capture attention, align early teams, or raise capital. Storytelling is the ultimate leverage."
              </p>
            </div>

            <div class="pt-4 border-t border-dashed border-stone-200/40 dark:border-stone-800/40 mt-6 flex items-center justify-between">
              <span class="text-xs font-mono text-stone-400 dark:text-stone-500 font-bold group-hover:text-brand-light dark:group-hover:text-brand-dark transition-colors">
                Read Thread on X &rarr;
              </span>
            </div>
          </div>

          <!-- Tech Projects Card -->
          <div class="flex flex-col border border-dashed border-brand-light/30 dark:border-brand-dark/30 bg-stone-50/40 dark:bg-stone-900/15 rounded-2xl p-6 hover:border-brand-light dark:hover:border-brand-dark transition-all duration-300 relative group shadow-sm">
            <div class="flex items-center gap-2 mb-4">
              <!-- GitHub Logo SVG -->
              <svg class="h-4 w-4 text-stone-400 dark:text-stone-500" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.59 1.087 3.222.83.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.137 20.162 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
              </svg>
              <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-stone-400 dark:text-stone-500">
                Founder Toolkits
              </span>
              <span class="absolute top-4 right-4 bg-stone-100 dark:bg-stone-900 text-stone-500 dark:text-stone-400 text-[9px] font-mono font-bold uppercase px-2 py-0.5 rounded">
                Open Source
              </span>
            </div>

            <div class="space-y-4 flex-grow">
              <!-- onepager -->
              <div class="space-y-1">
                <h4 class="font-mono text-base font-bold text-stone-950 dark:text-stone-50 hover:text-brand-light dark:hover:text-brand-dark transition-colors duration-200">
                  <a href="https://github.com/paidinesh7/onepager" target="_blank" rel="noopener noreferrer" class="highlighter-hover">
                    onepager ↗
                  </a>
                </h4>
                <p class="text-xs text-stone-600 dark:text-stone-400 font-serif leading-relaxed">
                  An AI-powered financial analyzer that generates quick briefs (Altman Z-Score, Piotroski F-Score, DuPont Analysis) from statements in under 2 minutes.
                </p>
              </div>

              <!-- LegalOS -->
              <div class="space-y-1">
                <h4 class="font-mono text-base font-bold text-stone-950 dark:text-stone-50 hover:text-brand-light dark:hover:text-brand-dark transition-colors duration-200">
                  <a href="https://github.com/paidinesh7/LegalOS" target="_blank" rel="noopener noreferrer" class="highlighter-hover">
                    LegalOS ↗
                  </a>
                </h4>
                <p class="text-xs text-stone-600 dark:text-stone-400 font-serif leading-relaxed">
                  An AI legal document analyzer designed specifically for Indian startup founders navigating fundraising agreements like SHAs and SPAs.
                </p>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- Daily Log / Snippets Stream -->
      <section class="border-t-2 border-dashed border-stone-200/40 dark:border-stone-800/40 pt-12 animate-fade-in-delayed">
        <div class="space-y-1 mb-8">
          <span class="text-xs font-bold uppercase tracking-widest text-stone-400 dark:text-stone-500 font-mono">
            Daily Log
          </span>
          <h2 class="font-mono text-xl sm:text-2xl font-bold text-stone-900 dark:text-stone-100 uppercase ink-bleed">
            [ Snippets & Micro-Notes ]
          </h2>
          <p class="font-serif italic text-stone-500 dark:text-stone-400 text-xs sm:text-sm">
            Quick, informal thoughts, quotes, and observations on things I read or come across.
          </p>
        </div>

        <div class="relative pl-6 border-l border-dashed border-brand-light/30 dark:border-brand-dark/30 space-y-8">
          {dailySnippets.map((snippet) => (
            <div class="relative group/snippet">
              <!-- Chronological dot indicator -->
              <span class="absolute -left-[30px] top-1.5 w-2.5 h-2.5 rounded-full bg-brand-light dark:bg-brand-dark group-hover/snippet:scale-125 transition-transform shadow-sm shadow-brand-light/45"></span>
              
              <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-mono">
                  <span class="font-bold text-stone-400 dark:text-stone-500">{snippet.date}</span>
                  <span class="text-stone-300 dark:text-stone-700">&bull;</span>
                  <span class="font-bold text-brand-light dark:text-brand-dark uppercase tracking-wide text-[10px] bg-brand-light/5 dark:bg-brand-dark/5 px-2 py-0.5 rounded">
                    {snippet.category}
                  </span>
                </div>
                
                <p class="font-serif text-sm sm:text-base text-stone-700 dark:text-stone-300 leading-relaxed max-w-2xl">
                  {snippet.content}
                </p>

                {snippet.link && (
                  <div class="pt-1">
                    <a 
                      href={snippet.link} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="inline-flex items-center gap-1 text-[11px] font-mono font-bold text-crimson-light dark:text-crimson-dark highlighter-hover"
                    >
                      {snippet.linkText || "Link"} &rarr;
                    </a>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Latest Field Notes Section -->
      <section class="border-t-2 border-dashed border-stone-200/40 dark:border-stone-800/40 pt-12 animate-fade-in-delayed">
        <div class="flex items-baseline justify-between mb-8">
          <h2 class="font-mono text-xl sm:text-2xl font-bold text-stone-900 dark:text-stone-100 uppercase ink-bleed">
            [ Latest Field Notes ]
          </h2>
          <a href="/blog" class="font-mono text-xs font-bold uppercase tracking-wider text-brand-light dark:text-brand-dark hover:text-stone-900 dark:hover:text-stone-100 transition-colors">
            Read All Archives &rarr;
          </a>
        </div>

        <!-- Newspaper grid of posts -->
        <div class="grid gap-8 md:grid-cols-3">
          {latestPosts.map((post) => (
            <article class="flex flex-col h-full border-b md:border-b-0 md:border-r last:border-r-0 border-stone-200/40 dark:border-stone-800/40 pb-6 md:pb-0 md:pr-6 last:pr-0 group">
              <div class="space-y-3 flex-grow">
                <!-- Post Date -->
                <time class="text-xs font-mono text-stone-400 dark:text-stone-500 font-bold">
                  {formatDate(post.data.date)}
                </time>

                <!-- Post Title -->
                <h3 class="font-serif text-base sm:text-lg font-bold leading-snug text-stone-900 dark:text-stone-100 group-hover:text-brand-light dark:group-hover:text-brand-dark transition-colors duration-200">
                  <a href={`/blog/${post.slug}`}>
                    {post.data.title}
                  </a>
                </h3>

                <!-- Post Description -->
                {post.data.description && (
                  <p class="font-serif text-stone-600 dark:text-stone-400 text-xs line-clamp-3 leading-relaxed">
                    {post.data.description}
                  </p>
                )}
              </div>

              <!-- Tags -->
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-4">
                  {post.data.tags.map((tag) => (
                    <span class="text-[9px] font-mono font-bold uppercase tracking-wider bg-stone-100/60 dark:bg-stone-900/60 text-stone-500 dark:text-stone-400 px-2 py-0.5 rounded">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>

      <!-- CTA/Newsletter Box -->
      <section class="bg-stone-100/30 dark:bg-stone-900/10 rounded-2xl border-2 border-dashed border-stone-200/60 dark:border-stone-800/60 p-6 sm:p-8 mt-16 sm:mt-24 text-center space-y-4 shadow-sm">
        <h3 class="font-mono text-lg font-bold text-stone-900 dark:text-stone-100 uppercase ink-bleed">
          [ Subscribe to the Feed ]
        </h3>
        <p class="text-sm text-stone-600 dark:text-stone-400 max-w-md mx-auto font-serif">
          Prefer reading in your own RSS reader? Add the RSS feed to stay updated with notes on private markets, finance, and capital markets.
        </p>
        <div>
          <a 
            href="/index.xml" 
            class="inline-flex items-center gap-2 bg-brand-light dark:bg-brand-dark hover:bg-stone-900 dark:hover:bg-stone-100 text-white dark:text-stone-950 font-mono text-xs font-bold uppercase tracking-wider px-4 py-2.5 rounded-lg transition-colors shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4">
              <path d="M4 11a9 9 0 0 1 9 9" />
              <path d="M4 4a16 16 0 0 1 16 16" />
              <circle cx="5" cy="19" r="1" />
            </svg>
            Subscribe via RSS
          </a>
        </div>
      </section>

    </div>
  </HomeTabs>
</BaseLayout>

<style>
  /* Elegant scroll reveal styles */
  .animate-fade-in {
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .animate-fade-in-delayed {
    opacity: 0;
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
