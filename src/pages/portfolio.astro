---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Company {
  name: string;
  category: 'Fintech' | 'Climate' | 'Health' | 'Deeptech';
  desc: string;
  thesis: string;
  logo: string;
  url: string;
}

const companies: Company[] = [
  // Fintech & Markets
  {
    name: "Assetplus",
    category: "Fintech",
    desc: "Digital mutual fund distribution platform for independent financial advisors.",
    thesis: "Giving independent mutual fund distributors across India the technology and operational tools to advise more families.",
    logo: "/static/images/portfolio/assetplus.png",
    url: "https://www.assetplus.in/"
  },
  {
    name: "Capitalmind",
    category: "Fintech",
    desc: "Quantitative portfolio management & public market research platform.",
    thesis: "Thoughtful, data-backed public market research and disciplined long-term portfolio management.",
    logo: "/static/images/portfolio/capitalmind.png",
    url: "https://www.capitalmind.in/"
  },
  {
    name: "Indiadatahub",
    category: "Fintech",
    desc: "Comprehensive Indian macroeconomic & corporate data platform.",
    thesis: "Making high-quality Indian macroeconomic and regional datasets accessible and affordable for researchers and businesses.",
    logo: "/static/images/portfolio/indiadatahub.png",
    url: "https://www.indiadatahub.com/"
  },
  {
    name: "M2P",
    category: "Fintech",
    desc: "Core banking, payments, and card issuance API infrastructure.",
    thesis: "Building the underlying payments and core banking plumbing that powers banks and fintechs across Asia.",
    logo: "/static/images/portfolio/m2p.png",
    url: "https://m2pfintech.com/"
  },
  {
    name: "Mprofit",
    category: "Fintech",
    desc: "Multi-asset portfolio tracking & accounting software.",
    thesis: "Bootstrapped, customer-obsessed software solving multi-asset portfolio accounting and tax tracking for Indian investors.",
    logo: "/static/images/portfolio/mprofit.png",
    url: "https://www.mprofit.in/"
  },
  {
    name: "Financialist",
    category: "Fintech",
    desc: "Wealth advisory and goal-based financial planning.",
    thesis: "Simplifying retirement and long-term financial planning into clear, conflict-free advice.",
    logo: "/static/images/portfolio/financialist.jpeg",
    url: "https://thefinancialist.co.in/"
  },

  // Climate & Energy
  {
    name: "Akshayakalpa",
    category: "Climate",
    desc: "Certified organic dairy farming & sustainable agriculture.",
    thesis: "Rebuilding rural farm livelihoods and soil health while delivering clean, antibiotic-free organic milk to urban homes.",
    logo: "/static/images/portfolio/akshayakalpa.png",
    url: "https://akshayakalpa.org/"
  },
  {
    name: "Green Worms",
    category: "Climate",
    desc: "Community-driven waste management & circular recovery.",
    thesis: "Building decentralized waste collection and recycling loops across coastal and rural towns while creating dignified local jobs.",
    logo: "/static/images/portfolio/greenworms.png",
    url: "https://greenworms.org/"
  },
  {
    name: "Krop AI",
    category: "Climate",
    desc: "Precision agriculture & crop quality analytics.",
    thesis: "Practical farm-level quality assessment and crop analytics to help farmers and buyers price produce fairly.",
    logo: "/static/images/portfolio/kropai.png",
    url: "https://rainmatter.com/"
  },
  {
    name: "Matchlog",
    category: "Climate",
    desc: "Container logistics optimization reducing empty haulage.",
    thesis: "Matching import and export container movements to eliminate empty truck trips to ports, cutting both freight cost and emissions.",
    logo: "/static/images/portfolio/matchlog.png",
    url: "https://matchlogsolutions.com/"
  },
  {
    name: "Naxatra Labs",
    category: "Climate",
    desc: "High-efficiency electric motors designed and built in India.",
    thesis: "First-principles electric motor engineering built locally to improve efficiency and reduce import dependence for EVs and industry.",
    logo: "/static/images/portfolio/naxatralabs.png",
    url: "https://naxatralabs.com/"
  },
  {
    name: "Neufin",
    category: "Climate",
    desc: "Climate finance and green transition advisory for businesses.",
    thesis: "Helping mid-market industrial businesses access project finance and clean energy for decarbonization.",
    logo: "/static/images/portfolio/neufin.png",
    url: "https://www.neufin.co/"
  },
  {
    name: "Ossus Bio",
    category: "Climate",
    desc: "Producing green bio-hydrogen directly from industrial wastewater.",
    thesis: "On-site bioreactors that treat industrial effluent while generating clean hydrogen gas for process industries.",
    logo: "/static/images/portfolio/ossusbio.png",
    url: "https://ossusbio.com/"
  },
  {
    name: "Solarsquare",
    category: "Climate",
    desc: "Residential rooftop solar installation & financing.",
    thesis: "Making residential rooftop solar simple, reliable, and accessible for Indian homeowners.",
    logo: "/static/images/portfolio/solarsquare.png",
    url: "https://www.solarsquare.in/"
  },
  {
    name: "Two Brothers Organic Farms",
    category: "Climate",
    desc: "Regenerative organic farming & clean food brand.",
    thesis: "Farmer-founders building a transparent, soil-first organic food brand directly from their village in Bhodani.",
    logo: "/static/images/portfolio/twobrothersorganicfarms.png",
    url: "https://twobrothersindiashop.com/"
  },
  {
    name: "Voltseal",
    category: "Climate",
    desc: "Cell-level thermal safety barriers for EV battery packs.",
    thesis: "Materials engineering that prevents thermal runaway and battery fires in electric vehicles deployed in Indian heat.",
    logo: "/static/images/portfolio/voltseal.png",
    url: "https://rainmatter.com/"
  },
  {
    name: "Zerocircle",
    category: "Climate",
    desc: "Seaweed-based biodegradable alternatives to single-use plastic.",
    thesis: "Turning cultivated ocean seaweed into home-compostable packaging films and coatings to replace petroleum plastics.",
    logo: "/static/images/portfolio/zerocircle.png",
    url: "https://www.zerocircle.in/"
  },

  // Health & Nutrition
  {
    name: "Adsys",
    category: "Health",
    desc: "Medical diagnostic & imaging devices engineered in India.",
    thesis: "Building reliable, cost-effective diagnostic hardware so smaller clinics and Tier-3 hospitals can afford quality care.",
    logo: "/static/images/portfolio/adsys.png",
    url: "https://rainmatter.com/"
  },
  {
    name: "Arboreal",
    category: "Health",
    desc: "Stevia-based natural sugar-reduction solutions.",
    thesis: "Helping food and beverage makers cut refined sugar without compromising taste, tackling India's metabolic health crisis.",
    logo: "/static/images/portfolio/arboreal.png",
    url: "https://arborealbio.com/"
  },
  {
    name: "Blackfrog",
    category: "Health",
    desc: "Portable medical-grade active cooling for last-mile vaccine delivery.",
    thesis: "Precision battery-powered cold-chain carriers ensuring vaccines stay strictly between 2–8°C up to the remotest health centers.",
    logo: "/static/images/portfolio/blackfrog.png",
    url: "https://www.blackfrog.in/"
  },
  {
    name: "Emoha",
    category: "Health",
    desc: "Connected home care and emergency support for senior citizens.",
