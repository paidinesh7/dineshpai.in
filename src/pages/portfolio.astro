  {
    name: "Sukino",
    category: "Health",
    desc: "Continuum of post-hospital rehabilitative and long-term care.",
    thesis: "Dedicated rehabilitation centers bridging the critical recovery gap between hospital ICU discharge and returning home.",
    logo: "/static/images/portfolio/sukino.png",
    url: "https://www.sukino.com/"
  },
  {
    name: "SuperYou",
    category: "Health",
    desc: "Clean, everyday protein snacks made accessible for Indian diets.",
    thesis: "Making everyday protein supplementation delicious, clean, and mainstream for protein-deficient Indian households.",
    logo: "/static/images/portfolio/superyou.png",
    url: "https://superyou.in/"
  },
  {
    name: "The Whole Truth",
    category: "Health",
    desc: "100% clean-label food brand with full ingredient transparency.",
    thesis: "Rebuilding consumer trust in packaged food by listing every single ingredient upfront with zero hidden sugars or chemicals.",
    logo: "/static/images/portfolio/thewholetruth.png",
    url: "https://thewholetruthfoods.com/"
  },

  // Deeptech & Space
  {
    name: "Galaxeye",
    category: "Deeptech",
    desc: "Multi-sensor earth-observation satellites combining SAR and optical imaging.",
    thesis: "Building hybrid SAR + optical satellites in India that capture clear earth imagery day or night, even through monsoon cloud cover.",
    logo: "/static/images/portfolio/galaxeye.png",
    url: "https://galaxeye.space/"
  },
  {
    name: "Karban",
    category: "Deeptech",
    desc: "Design-first air purification & energy-efficient airflow hardware.",
    thesis: "Rethinking home appliances from first principles—combining bladeless airflow, lighting, and medical-grade air purification.",
    logo: "/static/images/portfolio/karban.png",
    url: "https://karban.in/"
  },
  {
    name: "Spacefields",
    category: "Deeptech",
    desc: "Indigenous rocket propulsion and aerospace defense systems.",
    thesis: "Developing high-performance solid rocket propulsion and aerospike motors in India for aerospace and defense.",
    logo: "/static/images/portfolio/spacefields.png",
    url: "https://spacefields.in/"
  }
];

const totalCompanies = companies.length;
const climateCount = companies.filter(c => c.category === 'Climate').length;
const fintechCount = companies.filter(c => c.category === 'Fintech').length;
const healthCount = companies.filter(c => c.category === 'Health').length;
const deeptechCount = companies.filter(c => c.category === 'Deeptech').length;
---

<BaseLayout 
  title="My Investments" 
  description="Early-stage startups and teams Dinesh Pai has backed at Rainmatter across Fintech, Climate, Health, and Deeptech."
>
  <div class="max-w-3xl mx-auto space-y-12 py-6 font-serif">
    
    <!-- BACK TO HOME LINK -->
    <div class="font-mono text-xs uppercase tracking-wider">
      <a href="/" class="text-stone-500 dark:text-stone-400 hover:text-brand-light dark:hover:text-brand-dark hover:underline inline-flex items-center gap-1">
        &larr; Back to Home
      </a>
    </div>

    <!-- TITLE & OVERVIEW -->
    <header class="space-y-4">
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-stone-900 dark:text-stone-100 !mt-0 !mb-2">
        My Investments
      </h1>
      <p class="font-serif text-stone-700 dark:text-stone-300 text-sm sm:text-base leading-relaxed">
        Early-stage teams and enduring founders I have worked closely with and backed at <a href="https://rainmatter.com/" target="_blank" rel="noopener noreferrer" class="text-brand-light dark:text-brand-dark font-bold hover:underline">Rainmatter</a>. Because we invest our own capital without outside LPs or fund-cycle pressure, we partner patiently over 20- to 30-year horizons across fintech, climate, health, and Indian deeptech.
      </p>
    </header>

    <!-- INTERACTIVE DIRECTORY & FILTERS -->
    <section class="space-y-6">
      <div class="border-b border-stone-200/80 dark:border-stone-800/80 pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
        <h2 class="font-serif text-xl sm:text-2xl font-black text-stone-900 dark:text-stone-100 !m-0">
          Portfolio Companies
        </h2>
        <span id="filtered-count" class="font-mono text-xs font-bold text-stone-400 dark:text-stone-500 uppercase tracking-wider">
          Showing {totalCompanies} of {totalCompanies}
        </span>
      </div>

      <!-- FILTER CONTROLS -->
      <div class="space-y-4 bg-stone-100 dark:bg-stone-900/40 p-5 rounded-lg border border-stone-200/40 dark:border-stone-800/40">
        
        <!-- SEARCH -->
        <div class="space-y-1.5">
          <label for="company-search" class="font-mono text-[10px] font-bold uppercase tracking-wider text-stone-400 dark:text-stone-500 block">
            Search Companies & Thesis
          </label>
          <input 
            type="text" 
            id="company-search" 
            placeholder="Search by company name, sector, or keyword..." 
            class="w-full px-3.5 py-2 rounded border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-950 font-serif text-sm focus:outline-none focus:border-brand-light dark:focus:border-brand-dark transition-colors duration-200"
          />
        </div>

        <!-- SECTOR FILTER PILLS -->
        <div class="space-y-1.5">
          <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-stone-400 dark:text-stone-500 block">
            Sector Focus
          </span>
          <div class="flex flex-wrap gap-2">
            <button class="sector-btn stamp-badge stamp-green cursor-pointer" data-sector="all">All Sectors ({totalCompanies})</button>
            <button class="sector-btn stamp-badge stamp-neutral cursor-pointer" data-sector="Climate">Climate & Energy ({climateCount})</button>
            <button class="sector-btn stamp-badge stamp-neutral cursor-pointer" data-sector="Health">Health & Nutrition ({healthCount})</button>
            <button class="sector-btn stamp-badge stamp-neutral cursor-pointer" data-sector="Fintech">Fintech & Markets ({fintechCount})</button>
            <button class="sector-btn stamp-badge stamp-neutral cursor-pointer" data-sector="Deeptech">Deeptech & Space ({deeptechCount})</button>
          </div>
        </div>

      </div>

      <!-- PORTFOLIO GRID -->
      <div id="companies-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {companies.map((company) => {
          const searchCorpus = `${company.name} ${company.category} ${company.desc} ${company.thesis}`.toLowerCase();

          return (
            <a 
              href={company.url}
              target="_blank"
              rel="noopener noreferrer"
              class="company-card group p-5 rounded-lg bg-stone-100/50 dark:bg-stone-900/30 border border-stone-200/40 dark:border-stone-800/40 hover:border-accent-light dark:hover:border-accent-dark hover:-translate-y-0.5 hover:shadow-sm transition-all duration-300 flex flex-col justify-between no-underline"
              data-sector={company.category}
              data-search={searchCorpus}
            >
              <div class="space-y-3">
                
                <!-- TOP ROW: LOGO & SECTOR BADGE -->
                <div class="flex items-start justify-between gap-3">
                  <div class="flex items-center gap-3">
                    <div class="w-11 h-11 shrink-0 bg-white dark:bg-stone-950 rounded border border-stone-200/60 dark:border-stone-800/60 p-1.5 overflow-hidden flex items-center justify-center shadow-sm relative">
                      <img 
                        src={company.logo} 
                        alt={`${company.name} logo`} 
                        class="max-w-full max-h-full object-contain logo-img"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                      />
                      <div class="fallback-avatar hidden absolute inset-0 w-full h-full items-center justify-center font-mono text-base font-black bg-accent-light/10 text-accent-light dark:bg-accent-dark/20 dark:text-accent-dark uppercase rounded">
                        {company.name[0]}
                      </div>
                    </div>
                    
                    <div>
                      <h3 class="font-serif text-lg font-black text-stone-900 dark:text-stone-100 group-hover:text-accent-light dark:group-hover:text-accent-dark transition-colors duration-200 leading-tight !m-0 inline-flex items-center gap-1">
                        <span>{company.name}</span>
                        <span class="text-stone-400 dark:text-stone-500 text-xs font-normal opacity-0 group-hover:opacity-100 transition-opacity">&nearr;</span>
                      </h3>
                      <span class="font-mono text-[9px] uppercase tracking-wider text-stone-400 dark:text-stone-500 font-bold block pt-0.5">
                        {company.category}
                      </span>
                    </div>
                  </div>
                </div>

                <!-- DESCRIPTION -->
                <p class="text-stone-600 dark:text-stone-400 text-xs sm:text-sm leading-relaxed font-serif !m-0">
                  {company.desc}
                </p>

                <!-- WHY WE BACKED THEM (THESIS CALLOUT) -->
                <div class="pt-2.5 border-t border-dashed border-stone-200/80 dark:border-stone-800/80 space-y-1">
                  <span class="font-mono text-[9px] font-bold uppercase tracking-wider text-stone-400 dark:text-stone-500 block">
                    Why We Backed Them
                  </span>
                  <p class="font-serif italic text-xs text-stone-700 dark:text-stone-300 leading-relaxed pl-2 border-l-2 border-stone-300 dark:border-stone-700 !m-0">
                    "{company.thesis}"
                  </p>
                </div>

              </div>
            </a>
          );
        })}
      </div>

      <!-- NO RESULTS -->
      <div id="no-company-results" class="hidden text-center py-12 text-stone-500 dark:text-stone-400 font-serif italic text-sm">
        No companies match your search and filter combination.
      </div>
    </section>

    <!-- FOOTER DIVIDER -->
    <div class="border-t border-stone-200 dark:border-stone-800 pt-6 font-mono text-xs uppercase tracking-wider">
      <a href="/" class="text-stone-500 dark:text-stone-400 hover:text-brand-light dark:hover:text-brand-dark hover:underline">
        &larr; Back to Home
      </a>
    </div>

  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const searchInput = document.getElementById('company-search') as HTMLInputElement | null;
    const sectorButtons = document.querySelectorAll<HTMLButtonElement>('.sector-btn');
    const cards = document.querySelectorAll<HTMLElement>('.company-card');
    const countLabel = document.getElementById('filtered-count');
    const noResults = document.getElementById('no-company-results');

    let currentSector = 'all';
    let searchQuery = '';
    const totalCount = cards.length;

    function filterGrid() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const sector = card.dataset.sector || '';
        const searchCorpus = card.dataset.search || '';

        const matchesSector = currentSector === 'all' || sector === currentSector;
        const matchesSearch = !searchQuery || searchCorpus.includes(searchQuery.toLowerCase());

        if (matchesSector && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countLabel) {
        countLabel.textContent = `Showing ${visibleCount} of ${totalCount}`;
      }

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim();
        filterGrid();
      });
    }

    sectorButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        sectorButtons.forEach((b) => {
          b.classList.remove('stamp-green');
          b.classList.add('stamp-neutral');
        });

        btn.classList.remove('stamp-neutral');
        btn.classList.add('stamp-green');

        currentSector = btn.dataset.sector || 'all';
        filterGrid();
      });
    });
  });
</script>
