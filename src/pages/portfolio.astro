---
import BaseLayout from '../layouts/BaseLayout.astro';
import KellyWidget from '../components/KellyWidget';

const portfolio = {
  Fintech: [
    { name: "Assetplus", desc: "Digital mutual fund distribution platform for advisors.", logo: "/static/images/portfolio/assetplus.png" },
    { name: "Capitalmind", desc: "Quantitative investment management & research platform.", logo: "/static/images/portfolio/capitalmind.png" },
    { name: "Indiadatahub", desc: "Comprehensive Indian macroeconomic & corporate data engine.", logo: "/static/images/portfolio/indiadatahub.png" },
    { name: "M2P", desc: "Embedded API financial infrastructure & card issuance.", logo: "/static/images/portfolio/m2p.png" },
    { name: "Mprofit", desc: "Multi-asset portfolio management & accounting software.", logo: "/static/images/portfolio/mprofit.png" },
    { name: "Financialist", desc: "Simplifying wealth advisory and financial planning.", logo: "/static/images/portfolio/financialist.jpeg" }
  ],
  Climate: [
    { name: "Akshayakalpa", desc: "Certified organic dairy farming & sustainable agriculture.", logo: "/static/images/portfolio/akshayakalpa.png" },
    { name: "Green Worms", desc: "Waste management & circular economy waste-to-resource loops.", logo: "/static/images/portfolio/greenworms.png" },
    { name: "Krop AI", desc: "AI-powered precision farming & crop yield analytics.", logo: "/static/images/portfolio/kropai.png" },
    { name: "Matchlog", desc: "Optimizing container logistics & empty container repositioning.", logo: "/static/images/portfolio/matchlog.png" },
    { name: "Naxatra Labs", desc: "Developing gearless high-torque electric motors.", logo: "/static/images/portfolio/naxatralabs.png" },
    { name: "Neufin", desc: "SaaS platform aggregating climate finance & carbon offset capital.", logo: "/static/images/portfolio/neufin.png" },
    { name: "Ossus Bio", desc: "Generating clean green bio-hydrogen from industrial wastewater.", logo: "/static/images/portfolio/ossusbio.png" },
    { name: "Solarsquare", desc: "Residential rooftop solar installation & financing.", logo: "/static/images/portfolio/solarsquare.png" },
    { name: "Two Brothers Organic Farms", desc: "Regenerative, soil-first organic farming & consumer brand.", logo: "/static/images/portfolio/twobrothersorganicfarms.png" },
    { name: "Voltseal", desc: "Advanced cell-level thermal runaway barriers for EVs.", logo: "/static/images/portfolio/voltseal.png" },
    { name: "Zerocircle", desc: "Seaweed-based biodegradable packaging alternative to plastic.", logo: "/static/images/portfolio/zerocircle.png" }
  ],
  Health: [
    { name: "Adsys", desc: "Diagnostic devices & medical imaging technology.", logo: "/static/images/portfolio/adsys.png" },
    { name: "Arboreal", desc: "Stevia-based natural sugar-reduction solutions.", logo: "/static/images/portfolio/arboreal.png" },
    { name: "Blackfrog", desc: "Portable medical-grade active cooling for vaccine logistics.", logo: "/static/images/portfolio/blackfrog.png" },
    { name: "Emoha", desc: "Connected 360-degree senior citizen care ecosystem.", logo: "/static/images/portfolio/emoha.png" },
    { name: "Sukino", desc: "Out-of-hospital post-operative rehabilitative care.", logo: "/static/images/portfolio/sukino.png" },
    { name: "SuperYou", desc: "Accessible active-wear designed for diverse bodies.", logo: "/static/images/portfolio/superyou.png" },
    { name: "The Whole Truth", desc: "100% clean-label food & clean snacking brand.", logo: "/static/images/portfolio/thewholetruth.png" }
  ],
  Other: [
    { name: "Galaxeye", desc: "Multi-sensor imaging satellite constellations (SAR + Optical).", logo: "/static/images/portfolio/galaxeye.png" },
    { name: "Karban", desc: "Design-first home air purification & smart climate hardware.", logo: "/static/images/portfolio/karban.png" },
    { name: "Spacefields", desc: "Custom solid-fuel rocket propulsion systems.", logo: "/static/images/portfolio/spacefields.png" }
  ]
};
---

<BaseLayout title="My Investments" description="A simple, clean index of early-stage startups and teams Dinesh Pai has led investments for at Rainmatter.">
  <div class="max-w-3xl mx-auto space-y-16 py-6 font-serif">
    
    <!-- BACK TO HOME LINK -->
    <div class="font-mono text-xs uppercase tracking-wider">
      <a href="/" class="text-stone-500 dark:text-stone-400 hover:text-brand-light dark:hover:text-brand-dark hover:underline inline-flex items-center gap-1">
        &larr; Back to Home
      </a>
    </div>

    <!-- TITLE -->
    <header class="space-y-4">
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-stone-900 dark:text-stone-100">
        My Investments
      </h1>
      <p class="font-serif italic text-stone-500 dark:text-stone-400 text-sm sm:text-base border-l-2 border-stone-200 dark:border-stone-800 pl-4">
        investments I have led and learnt from.
      </p>
    </header>

    <!-- POSITION SIZING PHILOSOPHY / KELLY SIMULATOR -->
    <section class="space-y-6">
      <h2 class="font-serif text-xl sm:text-2xl font-black text-stone-900 dark:text-stone-100 border-b border-stone-200/80 dark:border-stone-800/80 pb-2">
        Position Sizing Philosophy
      </h2>
      <p class="text-stone-800 dark:text-stone-200 leading-relaxed text-sm sm:text-base font-serif">
        Managing private market investments isn't just about selecting high-potential teams; it's about <strong>rational capital allocation</strong>. We believe in taking simple ideas seriously and protecting against downside variance using conservative bet sizing. 
      </p>
      <KellyWidget client:load />
    </section>

    <!-- PORTFOLIO CATEGORIES -->
    <div class="space-y-16">
      {Object.entries(portfolio).map(([category, companies]) => (
        <section class="space-y-6">
          
          <!-- SUBTLY PROMINENT SERIF HEADER -->
          <h2 class="font-serif text-xl sm:text-2xl font-black text-stone-900 dark:text-stone-100 border-b border-stone-200/80 dark:border-stone-800/80 pb-2 flex justify-between items-baseline">
            <span>{category}</span>
            <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-stone-400 dark:text-stone-500">{companies.length} companies</span>
          </h2>
          
          <!-- PORTFOLIO GRID -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {companies.map((company) => (
              <div class="group p-5 rounded-lg bg-stone-100/50 dark:bg-stone-900/30 border border-stone-200/40 dark:border-stone-800/40 hover:border-accent-light dark:hover:border-accent-dark hover:-translate-y-1 hover:shadow-sm transition-all duration-300 flex flex-col justify-between">
                <div class="space-y-3">
                  
                  <!-- LOGO & TITLE HEADER -->
                  <div class="flex items-center gap-3.5">
                    <div class="w-12 h-12 shrink-0 bg-white dark:bg-stone-950 rounded border border-stone-200/60 dark:border-stone-800/60 p-1.5 overflow-hidden flex items-center justify-center shadow-sm relative">
                      
                      <!-- Robust image rendering with Javascript Error Fallback -->
                      <img 
                        src={company.logo} 
                        alt={`${company.name} logo`} 
                        class="max-w-full max-h-full object-contain logo-img"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                      />
                      
                      <!-- Dynamic Styled Letter Fallback if Image is missing -->
                      <div class="fallback-avatar hidden absolute inset-0 w-full h-full items-center justify-center font-mono text-base font-black bg-accent-light/10 text-accent-light dark:bg-accent-dark/20 dark:text-accent-dark uppercase rounded">
                        {company.name[0]}
                      </div>
                      
                    </div>
                    
                    <h3 class="font-serif text-lg font-black text-stone-900 dark:text-stone-100 group-hover:text-accent-light dark:group-hover:text-accent-dark transition-colors duration-200 leading-tight">
                      {company.name}
                    </h3>
                  </div>

                  <p class="text-stone-600 dark:text-stone-400 text-xs sm:text-sm leading-relaxed font-serif pt-1">
                    {company.desc}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- FOOTER DIVIDER -->
    <div class="border-t border-stone-200 dark:border-stone-800 pt-6 font-mono text-xs uppercase tracking-wider">
      <a href="/" class="text-stone-500 dark:text-stone-400 hover:text-brand-light dark:hover:text-brand-dark hover:underline">
        &larr; Back to Home
      </a>
    </div>

  </div>
</BaseLayout>
