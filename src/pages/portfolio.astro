---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Company {
  name: string;
  category: 'Fintech' | 'Climate' | 'Health' | 'Deeptech';
  desc: string;
  thesis: string;
  logo: string;
  url: string;
}

const companies: Company[] = [
  // Fintech & Markets
  {
    name: "Assetplus",
    category: "Fintech",
    desc: "Technology & compliance platform for mutual fund distributors.",
    thesis: "Most Indian households beyond Tier-1 cities still rely on human intermediaries to invest. Assetplus equips independent distributors with digital execution and back-office scale.",
    logo: "/static/images/portfolio/assetplus.png",
    url: "https://www.assetplus.in/"
  },
  {
    name: "Capitalmind",
    category: "Fintech",
    desc: "Quantitative portfolio management & public market research.",
    thesis: "Deepak Shenoy and team built one of India's most trusted market research voices first, then compounded that trust into a disciplined PMS and asset management business.",
    logo: "/static/images/portfolio/capitalmind.png",
    url: "https://www.capitalmind.in/"
  },
  {
    name: "Indiadatahub",
    category: "Fintech",
    desc: "Domestic macroeconomic, sectoral & corporate data terminal.",
    thesis: "Institutional-grade Indian economic data was historically locked behind expensive foreign terminals. Indiadatahub makes granular domestic datasets accessible at a fraction of the cost.",
    logo: "/static/images/portfolio/indiadatahub.png",
    url: "https://www.indiadatahub.com/"
  },
  {
    name: "M2P",
    category: "Fintech",
    desc: "Core banking, payments, and card issuance API infrastructure.",
    thesis: "Modern banking products require flexible middleware on top of legacy bank cores. M2P became the default issuance and payments plumbing for banks and fintechs across Asia.",
    logo: "/static/images/portfolio/m2p.png",
    url: "https://m2pfintech.com/"
  },
  {
    name: "Mprofit",
    category: "Fintech",
    desc: "Multi-asset portfolio accounting & tax reporting software.",
    thesis: "Built with capital discipline before raising institutional money, Mprofit solves the messy reality of multi-asset accounting, family office consolidation, and capital gains taxation in India.",
    logo: "/static/images/portfolio/mprofit.png",
    url: "https://www.mprofit.in/"
  },
  {
    name: "Financialist",
    category: "Fintech",
    desc: "Conflict-free wealth advisory & goal-based financial planning.",
    thesis: "Traditional wealth management is skewed by distribution commissions. Financialist focuses on unconflicted, lifecycle-based financial planning.",
    logo: "/static/images/portfolio/financialist.jpeg",
    url: "https://thefinancialist.co.in/"
  },

  // Climate & Energy
  {
    name: "Akshayakalpa",
    category: "Climate",
    desc: "Certified organic dairy & farm-level soil regeneration.",
    thesis: "Shashi Kumar proved that fixing rural dairy unit economics—bringing farmers from subsistence to predictable monthly cash flows—is the only durable way to produce clean, antibiotic-free milk.",
    logo: "/static/images/portfolio/akshayakalpa.png",
    url: "https://akshayakalpa.org/"
  },
  {
    name: "Green Worms",
    category: "Climate",
    desc: "Decentralized waste management & circular material recovery.",
    thesis: "Municipal waste economics fail without source segregation and local recovery loops. Green Worms builds financially self-sustaining waste infrastructure across coastal towns and islands.",
    logo: "/static/images/portfolio/greenworms.png",
    url: "https://greenworms.org/"
  },
  {
    name: "Krop AI",
    category: "Climate",
    desc: "Farm-gate crop grading & agricultural quality analytics.",
    thesis: "Objective quality assaying at the mandi and farm gate removes pricing opacity for both growers and institutional buyers.",
    logo: "/static/images/portfolio/kropai.png",
    url: "https://rainmatter.com/"
  },
  {
    name: "Matchlog",
    category: "Climate",
    desc: "Inland container triangulation & freight optimization.",
    thesis: "Import containers routinely return empty to ports while exporters pay for fresh haulage. Matchlog triangulates inland container flows to cut deadhead mileage, freight cost, and diesel burn.",
    logo: "/static/images/portfolio/matchlog.png",
    url: "https://matchlogsolutions.com/"
  },
  {
    name: "Naxatra Labs",
    category: "Climate",
    desc: "High-efficiency axial & radial flux electric motors.",
    thesis: "India's EV transition relies heavily on imported drivetrains and rare-earth magnets. Naxatra designs and manufactures high-torque, high-efficiency electric motors domestically.",
    logo: "/static/images/portfolio/naxatralabs.png",
    url: "https://naxatralabs.com/"
  },
  {
    name: "Neufin",
    category: "Climate",
    desc: "Project finance & clean energy transition platform for industry.",
    thesis: "Mid-market manufacturers want to decarbonize to lower power costs, but lack project-finance structuring. Neufin bridges industrial energy buyers with institutional debt and solar developers.",
    logo: "/static/images/portfolio/neufin.png",
    url: "https://www.neufin.co/"
  },
  {
    name: "Ossus Bio",
    category: "Climate",
    desc: "Microbial bioreactors producing green hydrogen from effluent.",
    thesis: "Green hydrogen via electrolysis is power-hungry and expensive. Ossus uses electro-active microbes to extract process hydrogen directly from industrial wastewater streams on-site.",
    logo: "/static/images/portfolio/ossusbio.png",
    url: "https://ossusbio.com/"
  },
  {
    name: "Solarsquare",
    category: "Climate",
    desc: "Residential rooftop solar engineering, installation & financing.",
    thesis: "Residential solar in India was fragmented across local contractors with inconsistent quality. Solarsquare standardized cyclone-safe engineering, installation speed, and financing for homeowners.",
    logo: "/static/images/portfolio/solarsquare.png",
    url: "https://www.solarsquare.in/"
  },
  {
    name: "Two Brothers Organic Farms",
    category: "Climate",
    desc: "Regenerative agriculture & farm-to-home food brand.",
    thesis: "Satyajit and Ajinkya Hange built an integrated regenerative farm in Bhodani first, proving that soil health, indigenous seeds, and supply-chain ownership create an enduring consumer brand.",
    logo: "/static/images/portfolio/twobrothersorganicfarms.png",
    url: "https://twobrothersindiashop.com/"
  },
  {
    name: "Voltseal",
    category: "Climate",
    desc: "Cell-level thermal runaway barriers for EV battery packs.",
    thesis: "Battery packs operating in 45°C Indian summers face severe thermal propagation risks. Voltseal's phase-change composite materials isolate cell failures before they cascade into fires.",
    logo: "/static/images/portfolio/voltseal.png",
    url: "https://rainmatter.com/"
  },
  {
    name: "Zerocircle",
    category: "Climate",
    desc: "Seaweed-derived biodegradable packaging films & coatings.",
    thesis: "Unlike PLA bioplastics that still require industrial composting, Zerocircle uses cultivated ocean seaweed to manufacture packaging films that dissolve harmlessly after use.",
    logo: "/static/images/portfolio/zerocircle.png",
    url: "https://www.zerocircle.in/"
  },

  // Health & Nutrition
  {
    name: "Adsys",
    category: "Health",
    desc: "Domestic medical diagnostic & clinical imaging hardware.",
    thesis: "Imported diagnostic equipment prices smaller Indian hospitals out of basic care. Adsys engineers reliable diagnostic hardware locally to bring down per-test economics in Tier-2 and Tier-3 towns.",
    logo: "/static/images/portfolio/adsys.png",
    url: "https://rainmatter.com/"
  },
  {
    name: "Arboreal",
    category: "Health",
    desc: "Enzymatic stevia extraction & natural sugar-reduction systems.",
    thesis: "Cutting refined sugar in mass-market beverages fails when natural sweeteners leave a bitter aftertaste. Arboreal's formulation science solves taste parity for food manufacturers.",
    logo: "/static/images/portfolio/arboreal.png",
    url: "https://arborealbio.com/"
  },
  {
    name: "Blackfrog",
    category: "Health",
    desc: "Solid-state portable active cooling for last-mile vaccine transport.",
    thesis: "Up to a quarter of vaccines degrade in the last mile when passive ice-boxes warm up or freeze vials. Blackfrog's Emvólio carrier maintains strict 2–8°C control on battery power.",
    logo: "/static/images/portfolio/blackfrog.png",
    url: "https://www.blackfrog.in/"
  },
  {
    name: "Emoha",
    category: "Health",
    desc: "In-home geriatric care & emergency response infrastructure.",
    thesis: "As urban nuclear families grow, elderly parents live alone without clinical coordination. Emoha combines 24/7 emergency dispatch with routine geriatric care at home.",
    logo: "/static/images/portfolio/emoha.png",
    url: "https://emoha.com/"
  },
  {
    name: "Sukino",
    category: "Health",
    desc: "Out-of-hospital continuum care & inpatient rehabilitation centers.",
    thesis: "Acute hospital beds are expensive and unsuited for post-stroke, ortho, or neurological recovery. Sukino operates dedicated step-down rehabilitation centers that lower recovery costs and readmissions.",
    logo: "/static/images/portfolio/sukino.png",
    url: "https://www.sukino.com/"
  },
  {
    name: "SuperYou",
    category: "Health",
    desc: "Fermented yeast-protein snacks formulated for Indian palates.",
    thesis: "Most Indian diets are heavily carbohydrate-skewed. SuperYou uses bio-fermented yeast protein to put clean protein into everyday snack formats without the chalkiness of whey.",
    logo: "/static/images/portfolio/superyou.png",
    url: "https://superyou.in/"
  },
  {
    name: "The Whole Truth",
    category: "Health",
    desc: "Clean-label packaged foods with 100% ingredient transparency.",
    thesis: "Shashank Mehta built a category-defining food company on a simple counter-positioned premise: print every single ingredient on the front of the pack and control manufacturing in-house.",
    logo: "/static/images/portfolio/thewholetruth.png",
    url: "https://thewholetruthfoods.com/"
  },

  // Deeptech & Space
  {
    name: "Galaxeye",
    category: "Deeptech",
    desc: "Multi-sensor earth-observation satellites fusing SAR and optical payloads.",
    thesis: "Optical satellites are blinded by cloud cover and night, while radar (SAR) imagery is hard to interpret. Galaxeye's Drishti sensor fuses both on a single microsatellite platform.",
    logo: "/static/images/portfolio/galaxeye.png",
    url: "https://galaxeye.space/"
  },
  {
    name: "Karban",
    category: "Deeptech",
    desc: "Aerodynamic airflow & medical-grade air purification hardware.",
    thesis: "Instead of selling three separate appliances for cooling, lighting, and air filtration, Karban engineered a single aerodynamic hardware unit built for Indian dust and room layouts.",
    logo: "/static/images/portfolio/karban.png",
    url: "https://karban.in/"
  },
  {
    name: "Spacefields",
    category: "Deeptech",
    desc: "Indigenous solid rocket propulsion & aerospike defense systems.",
    thesis: "Sovereign defense and small-satellite launch cadence depend on domestic energetics and propulsion. Spacefields designs and hot-fires modular solid rocket motors and aerospike thrusters in India.",
    logo: "/static/images/portfolio/spacefields.png",
    url: "https://spacefields.in/"
  }
];

const totalCompanies = companies.length;
const climateCount = companies.filter(c => c.category === 'Climate').length;
const fintechCount = companies.filter(c => c.category === 'Fintech').length;
const healthCount = companies.filter(c => c.category === 'Health').length;
const deeptechCount = companies.filter(c => c.category === 'Deeptech').length;
---

<BaseLayout 
  title="Investments" 
  description="Early-stage companies and founders Dinesh Pai has backed at Rainmatter across Fintech, Climate, Health, and Deeptech."
>
  <div class="max-w-3xl mx-auto space-y-12 py-6 font-serif">
    
    <!-- BACK TO HOME LINK -->
    <div class="font-mono text-xs uppercase tracking-wider">
      <a href="/" class="text-stone-500 dark:text-stone-400 hover:text-brand-light dark:hover:text-brand-dark hover:underline inline-flex items-center gap-1">
        &larr; Back to Home
      </a>
    </div>

    <!-- TITLE & OVERVIEW -->
    <header class="space-y-4">
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-stone-900 dark:text-stone-100 !mt-0 !mb-2">
        Investments
      </h1>
      <p class="font-serif text-stone-700 dark:text-stone-300 text-sm sm:text-base leading-relaxed">
        Companies and founders I have worked closely with at <a href="https://rainmatter.com/" target="_blank" rel="noopener noreferrer" class="text-brand-light dark:text-brand-dark font-bold hover:underline">Rainmatter</a>. Because we invest from Zerodha's balance sheet with no external LPs or fund-lifecycle pressure, we can underwrite long-duration businesses across fintech, climate, healthcare, and Indian deeptech.
      </p>
    </header>

    <!-- INTERACTIVE DIRECTORY & FILTERS -->
    <section class="space-y-6">
      <div class="border-b border-stone-200/80 dark:border-stone-800/80 pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
        <h2 class="font-serif text-xl sm:text-2xl font-black text-stone-900 dark:text-stone-100 !m-0">
          Portfolio Directory
        </h2>
        <span id="filtered-count" class="font-mono text-xs font-bold text-stone-400 dark:text-stone-500 uppercase tracking-wider">
          Showing {totalCompanies} of {totalCompanies}
        </span>
      </div>

      <!-- FILTER CONTROLS -->
      <div class="space-y-4 bg-stone-100 dark:bg-stone-900/40 p-5 rounded-lg border border-stone-200/40 dark:border-stone-800/40">
        
        <!-- SEARCH -->
        <div class="space-y-1.5">
          <label for="company-search" class="font-mono text-[10px] font-bold uppercase tracking-wider text-stone-400 dark:text-stone-500 block">
            Search Companies &amp; Investment Notes
          </label>
          <input 
            type="text" 
            id="company-search" 
            placeholder="Search by company name, sector, or thesis..." 
            class="w-full px-3.5 py-2 rounded border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-950 font-serif text-sm focus:outline-none focus:border-brand-light dark:focus:border-brand-dark transition-colors duration-200"
          />
        </div>

        <!-- SECTOR FILTER PILLS -->
        <div class="space-y-1.5">
          <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-stone-400 dark:text-stone-500 block">
            Sector
          </span>
          <div class="flex flex-wrap gap-2">
            <button class="sector-btn stamp-badge stamp-green cursor-pointer" data-sector="all">All ({totalCompanies})</button>
            <button class="sector-btn stamp-badge stamp-neutral cursor-pointer" data-sector="Climate">Climate &amp; Energy ({climateCount})</button>
            <button class="sector-btn stamp-badge stamp-neutral cursor-pointer" data-sector="Health">Health &amp; Nutrition ({healthCount})</button>
            <button class="sector-btn stamp-badge stamp-neutral cursor-pointer" data-sector="Fintech">Fintech &amp; Markets ({fintechCount})</button>
            <button class="sector-btn stamp-badge stamp-neutral cursor-pointer" data-sector="Deeptech">Deeptech &amp; Space ({deeptechCount})</button>
          </div>
        </div>

      </div>

      <!-- PORTFOLIO GRID -->
      <div id="companies-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {companies.map((company) => {
          const searchCorpus = `${company.name} ${company.category} ${company.desc} ${company.thesis}`.toLowerCase();

          return (
            <a 
              href={company.url}
              target="_blank"
              rel="noopener noreferrer"
              class="company-card group p-5 rounded-lg bg-stone-100/50 dark:bg-stone-900/30 border border-stone-200/40 dark:border-stone-800/40 hover:border-accent-light dark:hover:border-accent-dark hover:-translate-y-0.5 hover:shadow-sm transition-all duration-300 flex flex-col justify-between no-underline"
              data-sector={company.category}
              data-search={searchCorpus}
            >
              <div class="space-y-3">
                
                <!-- TOP ROW: LOGO & SECTOR BADGE -->
                <div class="flex items-start justify-between gap-3">
                  <div class="flex items-center gap-3">
                    <div class="w-11 h-11 shrink-0 bg-white dark:bg-stone-950 rounded border border-stone-200/60 dark:border-stone-800/60 p-1.5 overflow-hidden flex items-center justify-center shadow-sm relative">
                      <img 
                        src={company.logo} 
                        alt={`${company.name} logo`} 
                        class="max-w-full max-h-full object-contain logo-img"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                      />
                      <div class="fallback-avatar hidden absolute inset-0 w-full h-full items-center justify-center font-mono text-base font-black bg-accent-light/10 text-accent-light dark:bg-accent-dark/20 dark:text-accent-dark uppercase rounded">
                        {company.name[0]}
                      </div>
                    </div>
                    
                    <div>
                      <h3 class="font-serif text-lg font-black text-stone-900 dark:text-stone-100 group-hover:text-accent-light dark:group-hover:text-accent-dark transition-colors duration-200 leading-tight !m-0 inline-flex items-center gap-1">
                        <span>{company.name}</span>
                        <span class="text-stone-400 dark:text-stone-500 text-xs font-normal opacity-0 group-hover:opacity-100 transition-opacity">&nearr;</span>
                      </h3>
                      <span class="font-mono text-[9px] uppercase tracking-wider text-stone-400 dark:text-stone-500 font-bold block pt-0.5">
                        {company.category}
                      </span>
                    </div>
                  </div>
                </div>

                <!-- DESCRIPTION -->
                <p class="text-stone-800 dark:text-stone-200 text-xs sm:text-sm font-bold leading-snug font-serif !m-0">
                  {company.desc}
                </p>

                <!-- INVESTMENT NOTE -->
                <div class="pt-2.5 border-t border-dashed border-stone-200/80 dark:border-stone-800/80">
                  <p class="font-serif text-xs text-stone-600 dark:text-stone-400 leading-relaxed !m-0">
                    {company.thesis}
                  </p>
                </div>

              </div>
            </a>
          );
        })}
      </div>

      <!-- NO RESULTS -->
      <div id="no-company-results" class="hidden text-center py-12 text-stone-500 dark:text-stone-400 font-serif italic text-sm">
        No companies match your search and filter combination.
      </div>
    </section>

    <!-- FOOTER DIVIDER -->
    <div class="border-t border-stone-200 dark:border-stone-800 pt-6 font-mono text-xs uppercase tracking-wider">
      <a href="/" class="text-stone-500 dark:text-stone-400 hover:text-brand-light dark:hover:text-brand-dark hover:underline">
        &larr; Back to Home
      </a>
    </div>

  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const searchInput = document.getElementById('company-search') as HTMLInputElement | null;
    const sectorButtons = document.querySelectorAll<HTMLButtonElement>('.sector-btn');
    const cards = document.querySelectorAll<HTMLElement>('.company-card');
    const countLabel = document.getElementById('filtered-count');
    const noResults = document.getElementById('no-company-results');

    let currentSector = 'all';
    let searchQuery = '';
    const totalCount = cards.length;

    function filterGrid() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const sector = card.dataset.sector || '';
        const searchCorpus = card.dataset.search || '';

        const matchesSector = currentSector === 'all' || sector === currentSector;
        const matchesSearch = !searchQuery || searchCorpus.includes(searchQuery.toLowerCase());

        if (matchesSector && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countLabel) {
        countLabel.textContent = `Showing ${visibleCount} of ${totalCount}`;
      }

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim();
        filterGrid();
      });
    }

    sectorButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        sectorButtons.forEach((b) => {
          b.classList.remove('stamp-green');
          b.classList.add('stamp-neutral');
        });

        btn.classList.remove('stamp-neutral');
        btn.classList.add('stamp-green');

        currentSector = btn.dataset.sector || 'all';
        filterGrid();
      });
    });
  });
</script>
