---
---

<div class="fixed inset-0 pointer-events-none overflow-hidden select-none z-[0] bg-transparent">
  
  <!-- Massive, Low-Contrast Diagonal Stepped Ticker (Representing Market Transactions & Order Matching) -->
  <div class="absolute inset-0 opacity-[0.45] dark:opacity-[0.25] text-stone-300 dark:text-stone-900/60">
    <svg class="w-full h-full" fill="none" viewBox="0 0 1000 1000" preserveAspectRatio="none">
      
      <!-- Stepped Price Chart Watermark (Diagonal trend from bottom-left to top-right) -->
      <!-- Low contrast color almost matches the sage background, making it highly prominent but completely non-intrusive -->
      <path 
        d="M -50,900 
           L 100,900 L 100,800 
           L 250,800 L 250,830 L 300,830 L 300,720 
           L 450,720 L 450,650 L 520,650 L 520,680 L 600,680 L 600,510 
           L 720,510 L 720,440 L 800,440 L 800,470 L 900,470 L 900,320 
           L 1050,320" 
        stroke="currentColor" 
        stroke-width="1.5" 
        stroke-dasharray="4 4"
        class="text-[#d8deda] dark:text-[#131d17]"
      />
      
      <!-- Stepped Trendline 2 (Overlapping shorter fluctuation) -->
      <path 
        d="M -20,850 
           L 80,850 L 80,780 
           L 180,780 L 180,750 L 280,750 L 280,680 
           L 380,680 L 380,700 L 480,700 L 480,590 
           L 580,590 L 580,530 L 680,530 L 680,480 
           L 780,480 L 780,410 L 880,410 L 880,360 
           L 1020,360" 
        stroke="currentColor" 
        stroke-width="1" 
        class="text-[#dee4df] dark:text-[#111913]"
      />

    </svg>
  </div>

  <!-- Slowly Floating & Fading Candlestick Blocks (Representing Discrete Time Interval High/Low/Open/Close) -->
  <div class="absolute inset-0 pointer-events-none">
    
    <!-- Candlestick 1 (Bullish green-filled block) -->
    <div class="absolute top-[20%] left-[8%] opacity-[0.08] dark:opacity-[0.04] text-brand-light dark:text-brand-dark animate-float-candle-1 flex flex-col items-center">
      <div class="w-[1.5px] h-12 bg-currentColor"></div>
      <div class="w-3 h-6 bg-currentColor border border-currentColor -my-9 rounded-xs"></div>
    </div>

    <!-- Candlestick 2 (Bearish red-hollow block) -->
    <div class="absolute bottom-[30%] left-[20%] opacity-[0.07] dark:opacity-[0.035] text-crimson-light dark:text-crimson-dark animate-float-candle-2 flex flex-col items-center">
      <div class="w-[1px] h-16 bg-currentColor"></div>
      <div class="w-2.5 h-8 bg-[#ecf1ee] dark:bg-[#0c120e] border border-currentColor -my-12 rounded-xs"></div>
    </div>

    <!-- Candlestick 3 (Bullish green-filled block) -->
    <div class="absolute top-[40%] right-[15%] opacity-[0.08] dark:opacity-[0.04] text-brand-light dark:text-brand-dark animate-float-candle-3 flex flex-col items-center">
      <div class="w-[1.5px] h-14 bg-currentColor"></div>
      <div class="w-3.5 h-5 bg-currentColor border border-currentColor -my-9.5 rounded-xs"></div>
    </div>

    <!-- Candlestick 4 (Bearish red-hollow block) -->
    <div class="absolute top-[15%] right-[25%] opacity-[0.06] dark:opacity-[0.03] text-crimson-light dark:text-crimson-dark animate-float-candle-4 flex flex-col items-center">
      <div class="w-[1px] h-10 bg-currentColor"></div>
      <div class="w-2.5 h-4 bg-[#ecf1ee] dark:bg-[#0c120e] border border-currentColor -my-7 rounded-xs"></div>
    </div>

  </div>

  <!-- Pulsing Market Order Nodes (Key matching price points) -->
  <!-- Node 1: Buy Limit match (Soft green glow) -->
  <div class="absolute top-[68%] left-[30%] animate-pulse-slow">
    <div class="w-2.5 h-2.5 rounded-full bg-brand-light/35 dark:bg-brand-dark/20 relative">
      <span class="absolute inset-0 rounded-full bg-brand-light/25 dark:bg-brand-dark/20 animate-ping"></span>
    </div>
  </div>

  <!-- Node 2: Sell Stop match (Soft crimson glow) -->
  <div class="absolute bottom-[53%] right-[40%] animate-pulse-slower">
    <div class="w-2 h-2 rounded-full bg-crimson-light/30 dark:bg-crimson-dark/20 relative">
      <span class="absolute inset-0 rounded-full bg-crimson-light/20 dark:bg-crimson-dark/20 animate-ping"></span>
    </div>
  </div>

  <!-- Ambient Capital Pools (Deeper, highly blurred flow clouds) -->
  <div class="absolute top-[30%] left-[20%] w-80 h-80 rounded-full bg-[#dee4df]/20 dark:bg-[#131d17]/10 blur-3xl animate-float-capital"></div>
  <div class="absolute bottom-[20%] right-[15%] w-96 h-96 rounded-full bg-[#d8deda]/15 dark:bg-[#0e1611]/15 blur-3xl animate-float-capital-delayed"></div>

</div>

<style>
  /* Physical Floating Keyframes for Candlesticks */
  @keyframes floatCandle1 {
    0%, 100% { transform: translateY(0) rotate(1deg); }
    50% { transform: translateY(-20px) rotate(-1deg); }
  }
  @keyframes floatCandle2 {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(25px) rotate(1deg); }
  }
  @keyframes floatCandle3 {
    0%, 100% { transform: translateY(0) rotate(2deg); }
    50% { transform: translateY(-15px) rotate(-1deg); }
  }
  @keyframes floatCandle4 {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50% { transform: translateY(18px) rotate(2deg); }
  }

  @keyframes pulseSlow {
    0%, 100% { opacity: 0.4; transform: scale(0.9); }
    50% { opacity: 0.9; transform: scale(1.15); }
  }

  @keyframes pulseSlower {
    0%, 100% { opacity: 0.3; transform: scale(0.95); }
    50% { opacity: 0.8; transform: scale(1.1); }
  }

  @keyframes floatCapital {
    0%, 100% { transform: translateY(0) translateX(0); }
    50% { transform: translateY(-30px) translateX(15px); }
  }

  .animate-float-candle-1 { animation: floatCandle1 14s ease-in-out infinite; }
  .animate-float-candle-2 { animation: floatCandle2 18s ease-in-out infinite; }
  .animate-float-candle-3 { animation: floatCandle3 16s ease-in-out infinite; }
  .animate-float-candle-4 { animation: floatCandle4 12s ease-in-out infinite; }
  
  .animate-pulse-slow { animation: pulseSlow 5s ease-in-out infinite; }
  .animate-pulse-slower { animation: pulseSlower 7s ease-in-out infinite; }

  .animate-float-capital { animation: floatCapital 24s ease-in-out infinite; }
  .animate-float-capital-delayed { animation: floatCapital 30s ease-in-out infinite-delayed; }
</style>
