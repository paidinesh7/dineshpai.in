---
---

<div class="fixed inset-0 pointer-events-none overflow-hidden select-none z-[0] bg-transparent">
  
  <!-- Static Hand-Drawn Pencil Sketch of Market Cycles (Journal Sketchbook Style) -->
  <div class="absolute bottom-4 right-4 sm:right-12 w-[320px] sm:w-[500px] h-[220px] sm:h-[350px] opacity-[0.25] dark:opacity-[0.12] text-stone-400 dark:text-[#18231c]">
    <svg class="w-full h-full" viewBox="0 0 500 350" fill="none" xmlns="http://www.w3.org/2000/svg">
      
      <!-- Hand-Drawn Style X & Y Axes -->
      <!-- Slightly wavy lines simulating pencil strokes -->
      <path d="M 40 300 C 150 299, 300 301, 460 300" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <path d="M 50 40 C 51 120, 49 220, 50 310" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      
      <!-- Axis Arrows (Drawn with organic, quick pencil flicks) -->
      <path d="M 450 294 L 460 300 L 450 306" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M 44 50 L 50 40 L 56 50" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />

      <!-- Monospaced axis labels (Typewriter annotations) -->
      <text x="465" y="304" font-family="Courier New, monospace" font-size="10" font-style="italic" font-weight="bold" fill="currentColor">t</text>
      <text x="46" y="32" font-family="Courier New, monospace" font-size="10" font-style="italic" font-weight="bold" fill="currentColor">p</text>

      <!-- Faint hand-written-style grid lines (Dashed coordinate alignment) -->
      <path d="M 50 120 L 450 120" stroke="currentColor" stroke-width="0.75" stroke-dasharray="4 6" opacity="0.4" />
      <path d="M 50 210 L 450 210" stroke="currentColor" stroke-width="0.75" stroke-dasharray="4 6" opacity="0.4" />
      <path d="M 170 40 L 170 300" stroke="currentColor" stroke-width="0.75" stroke-dasharray="4 6" opacity="0.4" />
      <path d="M 310 40 L 310 300" stroke="currentColor" stroke-width="0.75" stroke-dasharray="4 6" opacity="0.4" />

      <!-- The Core Market Wave (Hand-sketched curve with small overlapping ripples) -->
      <path d="M 50 250 
               C 100 230, 130 110, 170 120 
               C 210 130, 240 240, 280 230 
               C 320 220, 350 70, 390 80 
               C 430 90, 440 140, 460 130" 
            stroke="currentColor" 
            stroke-width="2" 
            stroke-linecap="round" 
      />

      <!-- Analytical dotted projection line (Expected Trend) -->
      <path d="M 390 80 C 420 50, 440 60, 460 45" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 3" stroke-linecap="round" opacity="0.7" />

      <!-- Hand-drawn Candlestick Blocks sketched along the curve -->
      <!-- Candlestick A (Hatched/Shaded rise block) -->
      <!-- High/Low Wick -->
      <path d="M 120 120 L 120 190" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
      <!-- Polaroid Body Box -->
      <rect x="114" y="135" width="12" height="35" rx="1" fill="#ecf1ee" class="dark:fill-[#0c120e]" stroke="currentColor" stroke-width="1.25" />
      <!-- Hatch shading (Pencil lines) -->
      <path d="M 114 140 L 126 145 M 114 150 L 126 155 M 114 160 L 126 165" stroke="currentColor" stroke-width="0.75" opacity="0.6" />

      <!-- Candlestick B (Hollow decline block) -->
      <path d="M 220 140 L 220 220" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
      <rect x="215" y="160" width="10" height="40" rx="1" fill="#ecf1ee" class="dark:fill-[#0c120e]" stroke="currentColor" stroke-width="1.25" />

      <!-- Candlestick C (Hashed rise block) -->
      <path d="M 350 100 L 350 180" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
      <rect x="344" y="115" width="12" height="45" rx="1" fill="#ecf1ee" class="dark:fill-[#0c120e]" stroke="currentColor" stroke-width="1.25" />
      <path d="M 344 120 L 356 125 M 344 130 L 356 135 M 344 140 L 356 145 M 344 150 L 356 155" stroke="currentColor" stroke-width="0.75" opacity="0.6" />

      <!-- Support / Resistance trend indicators (Hand-sketched lines) -->
      <path d="M 80 105 L 190 135" stroke="currentColor" stroke-width="1" stroke-dasharray="2 2" opacity="0.7" />
      <path d="M 240 245 L 340 235" stroke="currentColor" stroke-width="1" stroke-dasharray="2 2" opacity="0.7" />

      <!-- Small Hand-written Annotation Labels -->
      <text x="135" y="165" font-family="Courier New, monospace" font-size="7" fill="currentColor" opacity="0.6">f(t) = cycle_1</text>
      <text x="365" y="145" font-family="Courier New, monospace" font-size="7" fill="currentColor" opacity="0.6">comp_trend_A</text>
      <text x="385" y="55" font-family="Courier New, monospace" font-size="7" fill="currentColor" opacity="0.6">proj_B</text>

    </svg>
  </div>

  <!-- Ambient background glow behind the sketch (static, no animation) -->
  <div class="absolute bottom-10 right-12 w-72 h-72 rounded-full bg-brand-light/10 dark:bg-brand-dark/5 blur-3xl opacity-60 dark:opacity-30"></div>

</div>
