---
import ThemeToggle from '../components/ThemeToggle';
import ReadingProgressBar from '../components/ReadingProgressBar';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  showProgress?: boolean;
}

const {
  title = "Dinesh Pai's blog",
  description = "Field notes on investments and capital markets",
  showProgress = false,
} = Astro.props;

const siteTitle = "Dinesh Pai's blog";
const pageTitle = title === siteTitle ? siteTitle : `${title} | ${siteTitle}`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <!-- Favicon -->
    <link rel="shortcut icon" href="/static/images/favicon.png" />

    <!-- Original Hugo Stylesheet (Restores original blog formatting, links, and spacing) -->
    <link rel="stylesheet" type="text/css" href="/static/style.css" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@400;500;600;700&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&display=swap" rel="stylesheet" />

    <!-- Theme Initialization Script (Avoids flashing light theme) -->
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
    </script>
  </head>
  <body class="bg-[#ecf1ee] dark:bg-[#0c120e] text-stone-800 dark:text-stone-200 min-h-screen flex flex-col font-serif transition-colors duration-300 antialiased selection:bg-brand-light/10 dark:selection:bg-brand-dark/20">
    
    {showProgress && <ReadingProgressBar client:load />}

    <!-- Sticky Header / Masthead -->
    <header class="border-b border-stone-200/60 dark:border-stone-800/60 bg-[#ecf1ee]/85 dark:bg-[#0c120e]/85 backdrop-blur-md sticky top-0 z-40 transition-colors duration-300">
      
      <!-- Vintage Masthead Metadata Bar -->
      <div class="max-w-4xl mx-auto px-6 pt-2 flex justify-between text-[9px] font-mono font-bold text-stone-400 dark:text-stone-500 uppercase tracking-widest border-b border-dashed border-stone-200/20 dark:border-stone-800/20 pb-1 mb-1 hidden sm:flex">
        <span>[ Published in Bengaluru ]</span>
        <span>[ Vol. III / No. XII ]</span>
        <span>[ EST. 2023 ]</span>
      </div>

      <div class="max-w-4xl mx-auto px-6 py-4 flex flex-row items-center justify-between gap-4">
        
        <!-- Logo & Title (Bespoke Aligned Masthead) -->
        <a href="/" class="group flex items-center gap-3">
          <img src="/static/images/logo.svg" alt="Dinesh Pai" class="h-9 w-9 sm:h-10 sm:w-10 transition-transform group-hover:rotate-6 dark:invert" />
          <div class="flex flex-col">
            <span class="font-serif text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-stone-900 dark:text-stone-100 group-hover:text-brand-light dark:group-hover:text-brand-dark transition-colors duration-200">
              Dinesh Pai
            </span>
            <span class="text-[9px] sm:text-[10px] text-stone-500 dark:text-stone-400 font-mono tracking-wide hidden sm:inline uppercase font-bold mt-0.5">
              Business & investments @ Zerodha
            </span>
          </div>
        </a>

        <!-- Navigation -->
        <nav class="flex items-center gap-4 sm:gap-6 text-xs sm:text-sm font-mono font-bold text-stone-600 dark:text-stone-400 uppercase tracking-wider">
          <a href="/" class="hover:text-stone-900 dark:hover:text-stone-100 transition-colors">Home</a>
          <a href="/blog" class="hover:text-stone-900 dark:hover:text-stone-100 transition-colors">Blog</a>
          <a href="/podcasts" class="hover:text-stone-900 dark:hover:text-stone-100 transition-colors">Podcasts</a>
          
          <div class="h-4 w-px bg-stone-200 dark:bg-stone-800 hidden xs:block"></div>
          
          <!-- RSS Icon -->
          <a href="/index.xml" title="Subscribe to RSS Feed" class="hover:text-stone-900 dark:hover:text-stone-100 transition-colors p-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rss h-4.5 w-4.5 text-brand-light dark:text-brand-dark">
              <path d="M4 11a9 9 0 0 1 9 9" />
              <path d="M4 4a16 16 0 0 1 16 16" />
              <circle cx="5" cy="19" r="1" />
            </svg>
          </a>

          <!-- Theme Toggle Button -->
          <ThemeToggle client:load />
        </nav>
      </div>

      <!-- Vintage Double Line separator under header -->
      <div class="max-w-4xl mx-auto border-t-4 border-double border-stone-200/40 dark:border-stone-800/40 h-1"></div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-4xl mx-auto w-full px-6 py-8 sm:py-12">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-stone-200/60 dark:border-stone-800/60 bg-[#ecf1ee]/45 dark:bg-[#0c120e]/45 py-8 transition-colors duration-300">
      <div class="max-w-4xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500 dark:text-stone-500">
        <div>
          Dinesh Pai &copy; 2023 - 2026. Built with Astro, React & Tailwind CSS.
        </div>
        <div class="flex gap-4">
          <a href="https://twitter.com/dineshpaii" target="_blank" rel="noopener noreferrer" class="hover:text-brand-light dark:hover:text-brand-dark transition-colors">Twitter</a>
          <a href="https://www.linkedin.com/in/paidinesh1/" target="_blank" rel="noopener noreferrer" class="hover:text-brand-light dark:hover:text-brand-dark transition-colors">LinkedIn</a>
          <a href="/llms.txt" class="hover:text-brand-light dark:hover:text-brand-dark transition-colors">llms.txt</a>
          <a href="/index.xml" class="hover:text-brand-light dark:hover:text-brand-dark transition-colors">RSS Feed</a>
        </div>
      </div>
    </footer>

  </body>
</html>
