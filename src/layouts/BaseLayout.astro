---
import ThemeToggle from '../components/ThemeToggle';
import ReadingProgressBar from '../components/ReadingProgressBar';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  showProgress?: boolean;
}

const {
  title = "Dinesh Pai's blog",
  description = "Dinesh Pai works at Zerodha, and manages their private investments at Rainmatter.",
  showProgress = false,
} = Astro.props;

const siteTitle = "Dinesh Pai";
const pageTitle = title === "Home" ? siteTitle : `${title} | ${siteTitle}`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph (WhatsApp, Slack, LinkedIn, Telegram Link Previews in Any Chat Window) -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dineshpai.in" />
    <meta property="og:image" content="https://dineshpai.in/static/images/dinesh_new.jpg" />
    <meta property="og:image:secure_url" content="https://dineshpai.in/static/images/dinesh_new.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X Card Previews (Renders as a gorgeous, large image card) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://dineshpai.in/static/images/dinesh_new.jpg" />
    
    <!-- Favicon -->
    <link rel="shortcut icon" href="/static/images/favicon.png" />

    <!-- Original Hugo Stylesheet -->
    <link rel="stylesheet" type="text/css" href="/static/style.css" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data Schema (GEO Optimization for AI Search Engines) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Dinesh Pai",
        "jobTitle": "Vice President of Business Analysis & Investments",
        "worksFor": {
          "@type": "Organization",
          "name": "Zerodha",
          "url": "https://zerodha.com"
        },
        "description": "Leads private market investments through Rainmatter and climate action initiatives through the Rainmatter Foundation.",
        "alumniOf": [
          {
            "@type": "EducationalOrganization",
            "name": "University of Calgary",
            "url": "https://ucalgary.ca"
          },
          {
            "@type": "EducationalOrganization",
            "name": "RV College of Engineering",
            "url": "https://rvce.edu.in"
          }
        ],
        "sameAs": [
          "https://twitter.com/dineshpaii",
          "https://www.linkedin.com/in/paidinesh1/",
          "https://www.instagram.com/dpai.me/",
          "https://github.com/paidinesh7",
          "https://dineshpai.in"
        ],
        "url": "https://dineshpai.in"
      }
    </script>

    <!-- Theme Initialization Script (Avoids flashing light theme) -->
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
    </script>
  </head>
  <body class="bg-[#ecf1ee] dark:bg-[#0c120e] text-stone-800 dark:text-stone-200 min-h-screen flex flex-col font-serif transition-colors duration-300 antialiased selection:bg-brand-light/10 dark:selection:bg-brand-dark/20">
    
    {showProgress && <ReadingProgressBar client:load />}

    <!-- Minimal Header / Navigation (Aligned to max-w-3xl to match the body grid exactly) -->
    <header class="border-b border-stone-200/40 dark:border-stone-800/40 py-6 mb-8 transition-colors duration-300 bg-[#ecf1ee]/85 dark:bg-[#0c120e]/85 backdrop-blur-md sticky top-0 z-40">
      <div class="max-w-3xl mx-auto px-6 flex flex-row items-center justify-between gap-4">
        <a href="/" class="flex flex-col gap-0.5 group">
          <span class="font-serif text-2xl sm:text-3xl font-black tracking-tight text-stone-900 dark:text-stone-100 hover:text-brand-light dark:hover:text-brand-dark transition-colors duration-200">
            Dinesh Pai
          </span>
          <span class="text-[10px] text-stone-500 dark:text-stone-400 font-mono tracking-wider uppercase font-bold">
            Business & investments @ Zerodha
          </span>
        </a>
        <div class="flex items-center gap-4 sm:gap-6">
          <a href="/portfolio" class="font-mono text-sm font-bold uppercase tracking-wider text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 hover:underline">
            Investments
          </a>
          <div class="flex items-center gap-2 sm:gap-3">
            <a href="https://twitter.com/dineshpaii" target="_blank" rel="noopener noreferrer" title="Twitter / X" class="text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-colors p-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z" />
              </svg>
            </a>
            <a href="https://www.linkedin.com/in/paidinesh1/" target="_blank" rel="noopener noreferrer" title="LinkedIn" class="text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-colors p-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                <rect x="2" y="9" width="4" height="12" />
                <circle cx="4" cy="4" r="2" />
              </svg>
            </a>
            <a href="https://www.instagram.com/dpai.me/" target="_blank" rel="noopener noreferrer" title="Instagram" class="text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-colors p-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
              </svg>
            </a>
            <a href="https://github.com/paidinesh7" target="_blank" rel="noopener noreferrer" title="GitHub" class="text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-colors p-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.2 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
            </a>
            <a href="/index.xml" title="Subscribe to RSS Feed" class="text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-colors p-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rss h-4 w-4">
                <path d="M4 11a9 9 0 0 1 9 9" />
                <path d="M4 4a16 16 0 0 1 16 16" />
                <circle cx="5" cy="19" r="1" />
              </svg>
            </a>
          </div>
          <ThemeToggle client:load />
        </div>
      </div>
    </header>

    <!-- Main Content (Tactile Stacked Paper Sheet) -->
    <main class="flex-grow max-w-3xl mx-auto w-full px-6 py-8 sm:py-12 relative z-10 sm:my-6 sm:rounded-xl sm:bg-white/20 sm:dark:bg-stone-900/10 sm:border sm:border-stone-200/40 sm:dark:border-stone-800/20 sm:shadow-sm sm:backdrop-blur-[1px] transition-colors duration-300">
      <slot />
    </main>

    <!-- Footer (Aligned to max-w-3xl to match the body grid exactly) -->
    <footer class="border-t border-stone-200/40 dark:border-stone-800/40 py-8 transition-colors duration-300">
      <div class="max-w-3xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500 dark:text-stone-500 font-sans">
        <div>
          Dinesh Pai &copy; 2023 - 2026. Built with Astro & Tailwind CSS.
        </div>
        <div class="flex gap-4 font-mono text-[10px] uppercase tracking-wider">
          <a href="https://twitter.com/dineshpaii" target="_blank" rel="noopener noreferrer" class="hover:underline text-stone-600 dark:text-stone-400">Twitter</a>
          <a href="https://www.linkedin.com/in/paidinesh1/" target="_blank" rel="noopener noreferrer" class="hover:underline text-stone-600 dark:text-stone-400">LinkedIn</a>
          <a href="https://www.instagram.com/dpai.me/" target="_blank" rel="noopener noreferrer" class="hover:underline text-stone-600 dark:text-stone-400">Instagram</a>
          <a href="/portfolio" class="hover:underline text-stone-600 dark:text-stone-400">Portfolio</a>
          <a href="/llms.txt" class="hover:underline text-stone-600 dark:text-stone-400">llms.txt</a>
          <a href="/index.xml" class="hover:underline text-stone-600 dark:text-stone-400">RSS</a>
        </div>
      </div>
    </footer>

  </body>
</html>
