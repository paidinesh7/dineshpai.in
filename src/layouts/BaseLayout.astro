---
import ThemeToggle from '../components/ThemeToggle';
import ReadingProgressBar from '../components/ReadingProgressBar';
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  showProgress?: boolean;
  maxWidth?: string;
}

const {
  title = "Dinesh Pai",
  description = "Dinesh Pai works at Zerodha, and manages their private investments at Rainmatter.",
  showProgress = false,
  maxWidth = "max-w-5xl",
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteTitle = "Dinesh Pai";
const pageTitle = title === "Home" || title === siteTitle ? siteTitle : `${title} | ${siteTitle}`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dineshpai.in" />
    <meta property="og:image" content="https://dineshpai.in/static/images/dinesh_new.jpg" />
    <meta property="og:image:secure_url" content="https://dineshpai.in/static/images/dinesh_new.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X Card Previews -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://dineshpai.in/static/images/dinesh_new.jpg" />

    <!-- Favicon & LLMs.txt -->
    <link rel="shortcut icon" href="/static/images/favicon.png" />
    <link rel="describedby" type="text/plain" href="/llms.txt" title="LLMs.txt" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Instrument+Sans:wght@400;500;600;700&family=Lora:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Dinesh Pai",
        "jobTitle": "Vice President of Business Analysis & Investments",
        "worksFor": {
          "@type": "Organization",
          "name": "Zerodha",
          "url": "https://zerodha.com"
        },
        "description": "Leads private market investments through Rainmatter and climate action initiatives through the Rainmatter Foundation.",
        "alumniOf": [
          {
            "@type": "EducationalOrganization",
            "name": "University of Calgary",
            "url": "https://ucalgary.ca"
          },
          {
            "@type": "EducationalOrganization",
            "name": "RV College of Engineering",
            "url": "https://rvce.edu.in"
          }
        ],
        "sameAs": [
          "https://x.com/dineshpaii",
          "https://www.linkedin.com/in/paidinesh1/",
          "https://www.instagram.com/dpai.me/",
          "https://github.com/paidinesh7",
          "https://dineshpai.in"
        ],
        "url": "https://dineshpai.in"
      }
    </script>

    <!-- Native View Transitions -->
    <ViewTransitions />

    <!-- Theme Initialization Script -->
    <script is:inline>
      const applyTheme = () => {
        const getThemePreference = () => {
          if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };
        const isDark = getThemePreference() === 'dark';
        document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
      };

      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body class="bg-[#f7f5f0] dark:bg-[#121210] text-stone-900 dark:text-stone-200 min-h-screen flex flex-col font-serif transition-colors duration-200 antialiased">

    {showProgress && <ReadingProgressBar client:load />}

    <!-- Editorial Header / Navigation -->
    <header class="border-b border-stone-300/80 dark:border-stone-800 bg-[#f7f5f0]/90 dark:bg-[#121210]/90 backdrop-blur-sm sticky top-0 z-40">
      <div class={`${maxWidth} mx-auto px-6 py-5 flex flex-wrap items-center justify-between gap-4`}>
        <a href="/" class="flex flex-col gap-0.5 group no-underline">
          <span class="font-serif text-xl sm:text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-100 group-hover:text-brand-light dark:group-hover:text-brand-dark transition-colors">
            Dinesh Pai
          </span>
          <span class="text-[11px] text-stone-500 dark:text-stone-400 font-mono tracking-wider uppercase">
            Business &amp; investments @ Zerodha
          </span>
        </a>

        <nav aria-label="Primary navigation" class="flex items-center gap-5 sm:gap-7">
          <a
            href="/thesis"
            class:list={[
              "font-mono text-xs sm:text-[13px] uppercase tracking-wider transition-colors",
              currentPath.startsWith('/thesis')
                ? "font-bold text-brand-light dark:text-brand-dark underline underline-offset-4"
                : "text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100"
            ]}
          >
            Thesis
          </a>
          <a
            href="/portfolio"
            class:list={[
              "font-mono text-xs sm:text-[13px] uppercase tracking-wider transition-colors",
              currentPath.startsWith('/portfolio')
                ? "font-bold text-brand-light dark:text-brand-dark underline underline-offset-4"
                : "text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100"
            ]}
          >
            Investments
          </a>
          <a
            href="/blog"
            class:list={[
              "font-mono text-xs sm:text-[13px] uppercase tracking-wider transition-colors",
              currentPath.startsWith('/blog')
                ? "font-bold text-brand-light dark:text-brand-dark underline underline-offset-4"
                : "text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100"
            ]}
          >
            Essays
          </a>
          <div class="pl-1 border-l border-stone-300 dark:border-stone-800 flex items-center">
            <ThemeToggle client:load />
          </div>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class={`flex-grow ${maxWidth} mx-auto w-full px-6 py-8 sm:py-12`}>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-stone-300/80 dark:border-stone-800 py-8 mt-8">
      <div class={`${maxWidth} mx-auto px-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-mono text-xs text-stone-500 dark:text-stone-400`}>
        <div>
          Dinesh Pai &middot; <a href="mailto:dinesh@zerodha.com" class="hover:text-stone-900 dark:hover:text-stone-100 hover:underline">dinesh@zerodha.com</a>
        </div>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[11px] uppercase tracking-wider">
          <a href="https://x.com/dineshpaii" target="_blank" rel="noopener noreferrer" class="hover:text-stone-900 dark:hover:text-stone-100 hover:underline">X / Twitter</a>
          <a href="https://www.linkedin.com/in/paidinesh1/" target="_blank" rel="noopener noreferrer" class="hover:text-stone-900 dark:hover:text-stone-100 hover:underline">LinkedIn</a>
          <a href="https://github.com/paidinesh7" target="_blank" rel="noopener noreferrer" class="hover:text-stone-900 dark:hover:text-stone-100 hover:underline">GitHub</a>
          <a href="/index.xml" class="hover:text-stone-900 dark:hover:text-stone-100 hover:underline">RSS</a>
          <a href="/llms.txt" class="hover:text-stone-900 dark:hover:text-stone-100 hover:underline">llms.txt</a>
        </div>
      </div>
    </footer>

  </body>
</html>
